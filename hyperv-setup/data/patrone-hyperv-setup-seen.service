[Unit]
Description=Note that Hyper-V has opened an enhanced session with this VM
Documentation=file:///usr/share/doc/patrone-hyperv-setup/README.md
ConditionVirtualization=microsoft

# Started by 62-patrone-hyperv-setup.rules. Patrone Hyper-V Setup takes the
# file to mean the VM is set to the transport Linux needs.
[Service]
Type=oneshot
StateDirectory=patrone-hyperv-setup
ExecStart=/usr/bin/touch /var/lib/patrone-hyperv-setup/enhanced-session
