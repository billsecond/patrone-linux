[Unit]
Description=Virtual Machine Setup: offer to set up what's missing
Documentation=file:///usr/share/doc/patrone-hyperv-setup/README.md
ConditionVirtualization=microsoft
# Not in the installer's live session, which has the disc at /cdrom (and
# boot=casper only when the boot menu says it, which Patrone's doesn't)
ConditionPathIsMountPoint=!/cdrom
ConditionKernelCommandLine=!boot=casper
# "Don't show this again"
ConditionPathExists=!%E/patrone-hyperv-setup/dont-show-at-login
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=graphical-session.target
# After first-login setup has started, so the dialog can wait for it to end
After=graphical-session.target gnome-initial-setup-first-login.service

[Service]
ExecStart=/usr/bin/patrone-hyperv-setup --at-login
Slice=app.slice

[Install]
WantedBy=graphical-session.target
