[Desktop Entry]
# Not "Hyper-V" in the name: Microsoft's guidelines keep its trademarks out
# of product names (docs/COMPLIANCE.md, item 15). Hyper-V is a trademark of
# the Microsoft group of companies.
Name=Virtual Machine Setup
Comment=Set up what PatroneOS needs in a Hyper-V virtual machine
Exec=patrone-hyperv-setup
Icon=org.patrone.HyperVSetup
Terminal=false
Type=Application
# It comes up by itself at login in a Hyper-V VM while something's missing
# (patrone-hyperv-setup.service); a Start menu entry would show on every
# computer, Hyper-V or not
NoDisplay=true
Categories=GTK;System;Settings;
StartupNotify=true
