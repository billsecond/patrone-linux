#!/bin/bash
# Virtual Machine Setup's "Set Up" button runs this through pkexec, with
# what's missing; polkit's action for it is in
# /usr/share/polkit-1/actions/org.patrone.hyperv-setup.policy.
#
#   apply [--dry-run] PART...
#
#   guest-tools        install patrone-guest-tools: Hyper-V's integration
#                      services (and VirtualBox's guest tools)
#   enhanced-session   install or update patrone-remote-desktop, whose
#                      service serves VMConnect's enhanced session (0.5.0
#                      and later), and turn that service on
#
# --dry-run says what it would do and needs no root: patrone-hyperv-setup
# --dry-run runs it that way, for testing.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

unit=patrone-remote-desktop-vmconnect.service
dry_run= enable= packages=()
for part; do
    case $part in
        --dry-run) dry_run=1 ;;
        guest-tools) packages+=(patrone-guest-tools) ;;
        enhanced-session)
            [[ -f /usr/lib/systemd/system/$unit ]] || packages+=(patrone-remote-desktop)
            enable=1
            ;;
        *)
            echo "Unknown part: $part" >&2
            exit 2
            ;;
    esac
done

if [[ -z $dry_run && $EUID -ne 0 ]]; then
    echo "Virtual Machine Setup runs this through pkexec." >&2
    exit 1
fi

run() {
    echo "+ $*"
    [[ -n $dry_run ]] || "$@"
}

if (( ${#packages[@]} )); then
    export DEBIAN_FRONTEND=noninteractive
    apt=(apt-get -o DPkg::Lock::Timeout=300)
    # Today's lists, for the newest version; without a network, the ones
    # there are
    run "${apt[@]}" update ||
        echo "The lists of packages didn't update; installing from the ones there are." >&2
    run "${apt[@]}" install -y -o Dpkg::Options::=--force-confdef \
        -o Dpkg::Options::=--force-confold "${packages[@]}"
fi
if [[ -n $enable ]]; then
    run systemctl enable --now "$unit"
fi
if [[ -n $dry_run ]]; then
    sleep 3
fi
