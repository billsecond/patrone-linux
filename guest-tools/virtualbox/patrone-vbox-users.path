# New accounts (Settings → Users, adduser) get VirtualBox's groups as soon
# as they're made, not only at the next boot.
[Unit]
Description=Watch for new accounts on VirtualBox
Documentation=file:/usr/share/doc/patrone-guest-tools/README.md
ConditionVirtualization=oracle
ConditionPathExists=/usr/sbin/VBoxService

[Path]
PathChanged=/etc/passwd
Unit=patrone-vbox-users.service

[Install]
WantedBy=paths.target
