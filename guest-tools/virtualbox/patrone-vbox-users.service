[Unit]
Description=Let every account use VirtualBox's shared folders
Documentation=file:/usr/share/doc/patrone-guest-tools/README.md
ConditionVirtualization=oracle
ConditionPathExists=/usr/sbin/VBoxService
# vboxsf and vboxdrmipc come from sysusers.d
After=systemd-sysusers.service
# Before anyone signs in, so the groups count from the first sign-in
Before=systemd-user-sessions.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/patrone-guest-tools/vbox-users

[Install]
WantedBy=multi-user.target
