# VirtualBox's screen helper for the session: lays the desktop out the way
# the VM's window (or windows) are, with VMSVGA graphics, VirtualBox's
# default for Linux. The resizing itself comes from VBoxDRMClient, which
# virtualbox-guest-utils starts at boot.
[Unit]
Description=VirtualBox screen layout helper
Documentation=file:/usr/share/doc/patrone-guest-tools/README.md
ConditionVirtualization=oracle
ConditionPathExists=/usr/bin/VBoxClient
ConditionPathExists=/dev/vboxuser
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/VBoxClient --vmsvga-session --foreground
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
