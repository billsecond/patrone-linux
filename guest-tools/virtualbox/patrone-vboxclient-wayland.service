# VirtualBox's shared clipboard (and drag and drop, where VirtualBox has it)
# in a Wayland session. Ubuntu's virtualbox-guest-x11 only starts VBoxClient
# from /etc/X11/Xsession.d, which a GNOME session on Wayland never runs.
[Unit]
Description=VirtualBox shared clipboard
Documentation=file:/usr/share/doc/patrone-guest-tools/README.md
ConditionVirtualization=oracle
ConditionPathExists=/usr/bin/VBoxClient
ConditionPathExists=/dev/vboxuser
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=/usr/bin/VBoxClient --wayland --foreground
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
