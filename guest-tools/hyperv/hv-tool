#!/bin/sh
# Runs one of Hyper-V's daemons from Ubuntu's linux-cloud-tools:
#   hv-tool hv_kvp_daemon -n
#
# Ubuntu's own wrappers (/usr/sbin/hv_kvp_daemon and the others) only run
# the copy built for the running kernel, so they fail when that kernel's
# tools aren't installed: in the live session, which boots the disc's
# kernel while the image has newer tools, and after a kernel update until
# the matching tools come. The kernel and the daemon agree on a protocol
# version when it starts, so another kernel's copy works too: this runs the
# running kernel's if it's there, else the newest.
set -eu

tool=$1
shift
tools=/usr/lib/linux-tools

if [ -x "$tools/$(uname -r)/$tool" ]; then
    exec "$tools/$(uname -r)/$tool" "$@"
fi

newest=
for candidate in "$tools"/*/"$tool"; do
    [ -x "$candidate" ] && newest=$(printf '%s\n%s\n' "$newest" "$candidate" | sort -V | tail -n 1)
done
if [ -z "$newest" ]; then
    echo "$tool: no linux-cloud-tools package has it" >&2
    exit 1
fi
echo "$tool: none for $(uname -r); running ${newest#"$tools"/}" >&2
exec "$newest" "$@"
