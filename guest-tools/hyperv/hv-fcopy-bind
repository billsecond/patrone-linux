#!/bin/sh
# Run by udev (61-patrone-hv-fcopy.rules) when Hyper-V offers its file copy
# channel, with the channel's device name:
#   hv-fcopy-bind eb765408-105f-49b6-b4aa-c123b64d17d4
#
# Since Linux 6.10 uio_hv_generic serves the channel, but only a driver that
# lists it (Ubuntu's from 7.0.0-38) takes it by itself; older ones, such as
# the installer disc's 7.0.0-30, leave it unbound, so file copy never
# starts. udev has loaded the driver by now. This hands the channel to it
# when it didn't take it.
[ -e "/sys/bus/vmbus/devices/$1/driver" ] && exit 0
echo 34d14be3-dee4-41c8-9ae7-6b174977c192 > /sys/bus/vmbus/drivers/uio_hv_generic/new_id
