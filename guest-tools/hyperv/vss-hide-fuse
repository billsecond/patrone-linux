#!/bin/sh
# Starts hv_vss_daemon (its command follows) in the service's own mount
# namespace (MountFlags=private, in patrone-guest-tools' drop-in for
# hv-vss-daemon.service):
#   vss-hide-fuse /usr/libexec/patrone-guest-tools/hv-tool hv_vss_daemon -n
#
# Before a backup or a production checkpoint, hv_vss_daemon freezes every
# file system whose source starts with /dev/, and gives up on the first it
# can't freeze. FUSE file systems give their source as /dev/fuse, and the
# clipboards of FreeRDP and GNOME Remote Desktop (Patrone Remote Desktop
# uses both) each mount one that even root can't open, so every production
# checkpoint failed while someone was signed in. They hold nothing to
# freeze. The service's namespace doesn't receive mounts made after it
# starts; this unmounts, in that namespace only, those already there (when
# the service is restarted with someone signed in). It has to be the
# daemon's own process: systemd gives each of a service's commands a new
# namespace, so an ExecStartPre= would unmount them in one thrown away.
set -eu

if [ "$(readlink /proc/self/ns/mnt)" = "$(readlink /proc/1/ns/mnt)" ]; then
    echo "not in a mount namespace of its own; leaving the mounts alone" >&2
else
    # /proc/self/mounts writes a space as \040, which printf %b turns back
    awk '$1 ~ "^/dev/" && $3 ~ /^fuse(\.|$)/ { print $2 }' /proc/self/mounts |
        while read -r dir; do
            umount -l "$(printf '%b' "$dir")" || true
        done
fi
exec "$@"
