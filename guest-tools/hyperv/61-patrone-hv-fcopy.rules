# Hyper-V's file copy (the Guest Service Interface, Copy-VMFile).
#
# Since Linux 6.10 the channel belongs to uio_hv_generic, which only takes
# it by itself where the driver lists it (Ubuntu's kernels from 7.0.0-38);
# hv-fcopy-bind hands it over on older ones.
SUBSYSTEM=="vmbus", ACTION=="add", ATTR{class_id}=="{34d14be3-dee4-41c8-9ae7-6b174977c192}", \
  RUN{builtin}+="kmod load uio_hv_generic", RUN+="/usr/libexec/patrone-guest-tools/hv-fcopy-bind %k"

# Then the daemon starts on the channel's UIO device. Ubuntu's
# 60-hv-fcopy-daemon.rules waits for the old /dev/vmbus/hv_fcopy instead.
SUBSYSTEM=="uio", KERNELS=="eb765408-105f-49b6-b4aa-c123b64d17d4", TAG+="systemd", ENV{SYSTEMD_WANTS}+="patrone-hv-fcopy.service"
