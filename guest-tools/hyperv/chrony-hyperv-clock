#!/bin/sh
# Run as root before chronyd starts (chrony.service.d/patrone-hyperv-clock.conf).
#
# On Hyper-V, gives chrony the host's clock as a source, the way a Windows
# guest takes its time from the host: hv_utils' Time Synchronization service
# shows the host's clock as a PTP clock, /dev/ptp_hyperv. chrony reads the
# line from /run/chrony/patrone (patrone-hyperv-clock.conf in
# /etc/chrony/conf.d). Anywhere else the folder stays empty, since chrony
# gives up on a refclock it can't open.
dir=/run/chrony/patrone
rm -f "$dir/hyperv-clock.conf"

[ "$(systemd-detect-virt --vm)" = microsoft ] || exit 0

# The clock only exists when the host offers Time Synchronization...
offered=
for class in /sys/bus/vmbus/devices/*/class_id; do
    [ "$(cat "$class" 2> /dev/null)" = "{9527e630-d0ae-497b-adce-e80ab0175caf}" ] && offered=yes
done
[ -n "$offered" ] || exit 0

# ...and it may appear a moment after chrony is started at boot.
udevadm wait --timeout=10 /dev/ptp_hyperv 2> /dev/null || [ -e /dev/ptp_hyperv ] || exit 0

mkdir -p "$dir"
# Microsoft's settings for Linux guests (poll every 8 s, filtered over 4 s
# samples); stratum 2, so the guest never claims to be a primary server.
echo "refclock PHC /dev/ptp_hyperv poll 3 dpoll -2 offset 0 stratum 2" > "$dir/hyperv-clock.conf"
