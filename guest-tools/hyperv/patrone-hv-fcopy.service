# Hyper-V's Guest Service Interface (Copy-VMFile from the host).
#
# Linux 6.10 moved file copy from hv_utils (/dev/vmbus/hv_fcopy) to a UIO
# device served by uio_hv_generic. Ubuntu's hv-fcopy-daemon.service still
# binds to the old device, so it never starts, and a drop-in can't take a
# BindsTo= away. This starts the same daemon on the new device;
# 61-patrone-hv-fcopy.rules gives the channel to uio_hv_generic and pulls
# this in when the device appears, and multi-user.target does at boot.
# Ubuntu's unit is kept off by a drop-in, since only one daemon may serve
# the channel. (Not Conflicts=: Ubuntu's unit, enabled at boot, would cancel
# this one's start even though its own condition then skips it.)
[Unit]
Description=Hyper-V Guest Service Interface (file copy from the host)
Documentation=file:/usr/share/doc/patrone-guest-tools/README.md
ConditionVirtualization=microsoft
# hv_fcopy_uio_daemon looks for the channel under this fixed name
ConditionPathExists=/sys/bus/vmbus/devices/eb765408-105f-49b6-b4aa-c123b64d17d4/uio

[Service]
# Any installed kernel's copy will do (hv-tool)
ExecStart=/usr/libexec/patrone-guest-tools/hv-tool hv_fcopy_uio_daemon -n

[Install]
WantedBy=multi-user.target
