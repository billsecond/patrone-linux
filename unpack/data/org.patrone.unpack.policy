<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Patrone Unpack installs a .deb package by running its helper as root
     through pkexec. An administrator's password is asked for every time. -->
<policyconfig>
  <vendor>Patrone Linux</vendor>
  <icon_name>org.patrone.Unpack</icon_name>

  <action id="org.patrone.unpack.install-deb">
    <description>Install a software package</description>
    <message>Installing software for everyone on this computer needs an administrator's password.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/patrone-unpack/install-deb</annotate>
  </action>
</policyconfig>
