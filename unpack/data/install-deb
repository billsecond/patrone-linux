#!/bin/bash
# Installs one .deb package with apt, for Patrone Unpack. Runs as root
# through pkexec, under polkit's org.patrone.unpack.install-deb action,
# which has already asked for an administrator's password.
#
#   /usr/libexec/patrone-unpack/install-deb /path/to/package.deb
#
# apt installs what the package needs from the archive. Its progress goes to
# standard output as "pmstatus:" lines (APT::Status-Fd), which Unpack shows
# as a progress bar, with everything else in its Details.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8
# No questions: debconf takes each question's default, and dpkg keeps
# changed settings files
export DEBIAN_FRONTEND=noninteractive

if [[ $# -ne 1 ]]; then
    echo "Usage: $0 FILE.deb" >&2
    exit 2
fi
source=$1
if [[ $source != /* || ! -f $source || -L $source ]]; then
    echo "Not a package file: $source" >&2
    exit 2
fi

# A copy apt's download user (_apt) can read, and that nobody can change
# between the check below and the install
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
chmod 755 "$work"
cp -- "$source" "$work/package.deb"
chmod 644 "$work/package.deb"
if ! dpkg-deb --info "$work/package.deb" > /dev/null; then
    echo "Not a .deb package: $source" >&2
    exit 2
fi

apt-get install --yes \
    -o APT::Status-Fd=1 \
    -o Dpkg::Use-Pty=0 \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    "$work/package.deb"
