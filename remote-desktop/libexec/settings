#!/bin/bash
# GNOME Settings' "Enable Remote Desktop" switch (System > Remote Desktop >
# Remote Login, in Patrone's build of Settings) runs this through pkexec. It
# acts for the account that runs Settings: always pkexec's caller
# (PKEXEC_UID), never an argument. polkit's actions for it are in
# /usr/share/polkit-1/actions/org.patrone.remote-desktop.policy.
#
#   settings status     whether Remote Desktop is on, whether the account may
#                       sign in, whether NLA can check its password yet, and
#                       whether other accounts may sign in (asks nothing)
#   settings enable     turn Remote Desktop on and let the account sign in
#                       (an administrator's password)
#   settings disable    turn Remote Desktop off, for every account (an
#                       administrator's password); the accounts stay in the
#                       group, so turning it on again needs no new password
#   settings password   check the account's password, on stdin, as a Remote
#                       Desktop sign-in would, and record what NLA checks
#                       (asks nothing more: the password is the check)
#
# status, enable and disable answer with lines on=, member=, password= and
# others=, each yes or no. password answers ok or denied.
set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

sam=/var/lib/patrone-remote-desktop/sam

if [[ $EUID -ne 0 || -z ${PKEXEC_UID:-} ]]; then
    echo "GNOME Settings runs this through pkexec." >&2
    exit 1
fi
user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1) || true
if [[ -z $user || $PKEXEC_UID -lt 1000 ]]; then
    echo "Remote Desktop is for accounts with a UID of 1000 or above." >&2
    exit 1
fi

yes_no() {
    if "$@"; then echo yes; else echo no; fi
}

is_member() {
    local groups
    groups=$(id -nG "$user")
    [[ " $groups " == *" remote-desktop "* ]]
}

# The SAM file has the account's NT hash, which a password sign-in records
has_hash() {
    [[ -f $sam ]] && awk -F: -v user="$user" '$1 == user { found = 1 } END { exit !found }' "$sam"
}

has_others() {
    local members name names
    members=$(getent group remote-desktop | cut -d: -f4) || return 1
    IFS=, read -ra names <<< "$members"
    for name in "${names[@]}"; do
        [[ -n $name && $name != "$user" ]] && return 0
    done
    return 1
}

status() {
    echo "on=$(yes_no systemctl is-active --quiet patrone-remote-desktop.service)"
    echo "member=$(yes_no is_member)"
    echo "password=$(yes_no has_hash)"
    echo "others=$(yes_no has_others)"
}

case ${1:-} in
    status)
        status
        ;;
    enable)
        patrone-remote-desktop enable > /dev/null
        is_member || adduser --quiet "$user" remote-desktop
        status
        ;;
    disable)
        patrone-remote-desktop disable > /dev/null
        status
        ;;
    password)
        # PAM checks it with Remote Desktop's own service (the group, the
        # password, the account not locked or expired), as at a sign-in
        exec /usr/libexec/patrone-remote-desktop/auth --confirm "$user"
        ;;
    *)
        echo "Usage: settings status|enable|disable|password" >&2
        exit 1
        ;;
esac
