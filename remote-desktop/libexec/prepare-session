#!/bin/bash
# Gets an account's desktop ready: the one GNOME desktop session the account
# has, which runs without a monitor and which every screen shows through
# Remote Desktop, like a Windows session. The sign-in helper runs it as root,
# for a Remote Desktop client once the password has been checked, or for the
# machine's own screen (the Patrone Desktop session), with the asker on the
# other end of stdout. It answers one line:
#
#   ok PORT SECRET   the port of the account's own GNOME Remote Desktop, and
#                    the random secret to sign in to it with
#   busy             the account is signed in on the machine's screen with a
#                    plain GNOME session (the Ubuntu session), which can't be
#                    shared; GNOME runs one desktop session per account
#   error            anything else (details in the journal)
set -euo pipefail

user=$1
uid=$(id -u "$user")
home=$(getent passwd "$user" | cut -d: -f6)
port=$((20000 + uid))
runtime=/run/user/$uid
secrets=/var/lib/patrone-remote-desktop/secrets
grd=$home/.local/share/gnome-remote-desktop

fail() {
    echo "prepare-session: $user: $*" >&2
    echo error
    exit 1
}
trap 'fail "failed at line $LINENO"' ERR

if ((uid < 1000 || port > 65535)); then
    fail "account outside the range Remote Desktop serves (uid $uid)"
fi

# One connection at a time per account
exec 9> "/run/patrone-remote-desktop/$user.lock"
flock 9

# Runs a command as the account, in its service manager's environment
as_user() {
    runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="$runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus" "$@"
}

# Retries a check every half second, up to $1 times
wait_for() {
    local tries=$1
    shift
    until "$@"; do
        ((--tries > 0)) || return 1
        sleep 0.5
    done
}

port_open() {
    [[ -n $(ss -Hltn "sport = :$port") ]]
}

# Whether logind session $1 is a Patrone Desktop session (the screen's viewer,
# which runs libexec/console) rather than a desktop of its own. logind has no
# desktop name for GDM's sessions, so look at what runs in it.
viewer_session() {
    local pid
    for pid in $(< "/sys/fs/cgroup/user.slice/user-$uid.slice/session-$1.scope/cgroup.procs"); do
        if tr '\0' ' ' < "/proc/$pid/cmdline" 2> /dev/null |
            grep -q /usr/libexec/patrone-remote-desktop/console; then
            return 0
        fi
    done 2> /dev/null
    return 1
}

# The secret the proxy signs in with, made once per account and readable by
# root only. It is never the account's password.
if [[ ! -s $secrets/$user ]]; then
    install -d -m 700 "$secrets"
    (umask 077 && head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$secrets/$user")
fi
secret=$(< "$secrets/$user")

# The account's service manager and session bus, which GNOME Remote Desktop's
# settings and the desktop session need
systemctl start "user@$uid.service"

# The account's own GNOME Remote Desktop, on its own port, with its own TLS
# certificate (made once), and the secret as its credentials
if [[ ! -f $grd/patrone-rdp-tls.crt ]]; then
    as_user mkdir -p "$grd"
    as_user openssl req -x509 -newkey rsa:3072 -nodes -days 3650 -quiet \
        -subj "/CN=$(hostname)" -keyout "$grd/patrone-rdp-tls.key" \
        -out "$grd/patrone-rdp-tls.crt"
fi
grdctl=(as_user grdctl --headless rdp)
"${grdctl[@]}" set-tls-cert "$grd/patrone-rdp-tls.crt" 2> /dev/null
"${grdctl[@]}" set-tls-key "$grd/patrone-rdp-tls.key" 2> /dev/null
"${grdctl[@]}" set-port "$port" 2> /dev/null
"${grdctl[@]}" disable-port-negotiation 2> /dev/null
"${grdctl[@]}" disable-view-only 2> /dev/null
printf '%s\n' "$secret" | "${grdctl[@]}" set-credentials "$user" 2> /dev/null
"${grdctl[@]}" enable 2> /dev/null

# The desktop session, with no monitor, unless it's running already. A
# Patrone Desktop session on the screen is only a viewer of it; a plain GNOME
# one is a second desktop, which GNOME can't run beside this one.
session=gnome-headless-session@$user.service
if ! systemctl is-active --quiet "$session"; then
    for id in $(loginctl list-sessions --no-legend | awk -v user="$user" '$3 == user { print $1 }'); do
        case $(loginctl show-session "$id" -p Type --value) in
            wayland | x11)
                if ! viewer_session "$id"; then
                    echo "prepare-session: $user is signed in on this machine's screen with a plain GNOME session ($id)" >&2
                    echo busy
                    exit 0
                fi
                ;;
        esac
    done
    systemctl start "$session"
fi

wait_for 120 as_user systemctl --user --quiet is-active gnome-session.target ||
    fail "the desktop session didn't start"
as_user systemctl --user start gnome-remote-desktop-headless.service
wait_for 60 port_open || fail "GNOME Remote Desktop isn't listening on port $port"

echo "ok $port $secret"
