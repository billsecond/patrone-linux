#!/usr/bin/python3
"""Patrone's desktop on the machine's own screen.

GDM runs this when someone signs in on the screen with the "Patrone Desktop"
session. It asks patrone-remote-desktop's session helper to get the account's
desktop ready (the same desktop Remote Desktop connects to, which runs
whether or not anyone is looking at it), then shows it full screen through a
local Remote Desktop client in cage, a one-app compositor.

As on Windows, the desktop is in one place at a time: signing in here
disconnects a Remote Desktop client, and a Remote Desktop sign-in ends this
view, which takes the screen back to the login screen. GNOME Remote Desktop
does the switching: a new client replaces the one before it.
"""

import os
import pwd
import socket
import subprocess
import sys

HELPER = "/run/patrone-remote-desktop/console.sock"


def ask_for_desktop():
    """Returns the port and secret of this account's desktop, started if need be."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.connect(HELPER)
        connection.shutdown(socket.SHUT_WR)
        answer = connection.makefile().readline().split()
    if len(answer) != 3 or answer[0] != "ok":
        raise RuntimeError(answer[0] if answer else "no answer")
    return answer[1], answer[2]


def main():
    try:
        port, secret = ask_for_desktop()
    except (OSError, RuntimeError) as error:
        print(f"patrone-console: can't get the desktop ready: {error}", file=sys.stderr)
        return 1

    user = pwd.getpwuid(os.getuid()).pw_name
    client = [
        "sdl-freerdp",
        f"/v:127.0.0.1:{port}",
        f"/u:{user}",
        "/from-stdin:force",  # the secret, below, never on a command line
        "/cert:ignore",  # the desktop's own self-signed certificate, on localhost
        "+f",
        "-toggle-fullscreen",
        "+dynamic-resolution",
        "/sound",
        "/log-level:WARN",
    ]
    environment = dict(os.environ, WLR_NO_HARDWARE_CURSORS="1")
    # -s lets Ctrl+Alt+F1-F12 switch virtual terminals.
    viewer = subprocess.Popen(
        ["cage", "-s", "--", *client], stdin=subprocess.PIPE, text=True, env=environment
    )
    viewer.stdin.write(secret + "\n")
    viewer.stdin.close()
    return viewer.wait()


if __name__ == "__main__":
    sys.exit(main())
