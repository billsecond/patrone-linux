#!/bin/sh
# Makes the certificate for Hyper-V's enhanced session, once: the proxy's,
# where Hyper-V's host asks for TLS, and the login screen's, on its local
# socket. The proxy's service runs it as its own user, in its own folder.
set -eu

state=${1:-/var/lib/patrone-remote-desktop/vmconnect}
if [ ! -s "$state/tls.crt" ] || [ ! -s "$state/tls.key" ]; then
    umask 077
    openssl req -x509 -newkey rsa:3072 -nodes -days 3650 -quiet \
        -subj "/CN=$(hostname)" -keyout "$state/tls.key" -out "$state/tls.crt"
fi
