#!/bin/sh
# Runs at each GNOME login, from /etc/xdg/autostart. A session with no seat is
# a Remote Desktop one: there it turns off the screen lock and screen
# blanking, which nobody expects in a remote window, after saving the
# account's own settings. On the machine's own screen it puts those back.
# GNOME keeps these settings per account, not per session, and runs one
# desktop session per account at a time, so the session that starts decides.
session=$(loginctl show-user "$USER" -p Display --value)
[ -n "$session" ] || exit 0
saved="${XDG_STATE_HOME:-$HOME/.local/state}/patrone/screen-lock-before-rdp"

if [ -z "$(loginctl show-session "$session" -p Seat --value)" ]; then
    if [ ! -f "$saved" ]; then
        mkdir -p "$(dirname "$saved")"
        {
            gsettings get org.gnome.desktop.screensaver lock-enabled
            gsettings get org.gnome.desktop.session idle-delay
        } > "$saved"
    fi
    gsettings set org.gnome.desktop.screensaver lock-enabled false
    gsettings set org.gnome.desktop.session idle-delay 0
elif [ -f "$saved" ]; then
    {
        read -r lock
        read -r delay
    } < "$saved"
    gsettings set org.gnome.desktop.screensaver lock-enabled "$lock"
    gsettings set org.gnome.desktop.session idle-delay "$delay"
    rm -f "$saved"
fi
