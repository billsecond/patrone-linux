#!/bin/sh
# The "Patrone Desktop" session, which GDM runs from gnome.desktop: the name
# GDM falls back to when an account has no valid session of its own, and the
# only session on Patrone's login screen.
#
# On the machine's screen (a session with a seat) it shows the account's one
# desktop through the console viewer. Without a seat, which is how GDM runs
# that desktop in the background (gnome-headless-session@USER), it is the
# desktop: Ubuntu's GNOME session, as ubuntu.desktop ran it.
seat=$(loginctl show-session "${XDG_SESSION_ID:-}" -p Seat --value 2> /dev/null) || seat=
[ -n "$seat" ] || seat=${XDG_SEAT:-}

if [ -n "$seat" ]; then
    exec /usr/libexec/patrone-remote-desktop/console
fi
exec /usr/bin/gnome-session --session=ubuntu
