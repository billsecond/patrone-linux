[Unit]
Description=Patrone desktop for the machine's own screen
CollectMode=inactive-or-failed

[Service]
# Root: it starts the account's desktop.
ExecStart=/usr/libexec/patrone-remote-desktop/auth --console
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=patrone-remote-desktop-console
TimeoutSec=180
