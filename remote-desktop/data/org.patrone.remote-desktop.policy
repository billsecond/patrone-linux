<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  GNOME Settings' "Enable Remote Desktop" switch, in Patrone's build of
  Settings, runs /usr/libexec/patrone-remote-desktop/settings through pkexec,
  which picks the action by the helper's first argument. The helper acts only
  for the account that runs it. Patrone's desktops have no seat, so polkit
  counts them as "any", not "active": each action allows all three the same.
-->
<policyconfig>
  <vendor>PatroneOS</vendor>

  <action id="org.patrone.remote-desktop.status">
    <description>See whether Remote Desktop is on for your account</description>
    <message>Authentication is required to see whether Remote Desktop is on</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/patrone-remote-desktop/settings</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">status</annotate>
  </action>

  <action id="org.patrone.remote-desktop.enable">
    <description>Turn on Remote Desktop for your account</description>
    <message>Authentication is required to turn on Remote Desktop</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/patrone-remote-desktop/settings</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">enable</annotate>
  </action>

  <action id="org.patrone.remote-desktop.disable">
    <description>Turn off Remote Desktop</description>
    <message>Authentication is required to turn off Remote Desktop</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/patrone-remote-desktop/settings</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">disable</annotate>
  </action>

  <!-- Checks the account's own password, which it must give: no more than
       any password sign-in (su, the login screen) does -->
  <action id="org.patrone.remote-desktop.password">
    <description>Confirm your password for Remote Desktop</description>
    <message>Authentication is required to confirm your password for Remote Desktop</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/patrone-remote-desktop/settings</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">password</annotate>
  </action>
</policyconfig>
