[Unit]
Description=Patrone Remote Desktop
Documentation=file:///usr/share/doc/patrone-remote-desktop/README.md
After=network.target gdm.service patrone-remote-desktop-auth.socket
Wants=patrone-remote-desktop-auth.socket
# GNOME's own Remote Login daemon also wants port 3389.
Conflicts=gnome-remote-desktop.service

[Service]
User=patrone-rdp
Group=patrone-rdp
Environment=HOME=/var/lib/patrone-remote-desktop/proxy
ExecStart=/usr/bin/freerdp-proxy /etc/patrone-remote-desktop/proxy.ini
Restart=on-failure
StateDirectory=patrone-remote-desktop/proxy
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
