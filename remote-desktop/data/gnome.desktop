[Desktop Entry]
# Installed as /usr/share/wayland-sessions/gnome.desktop by
# patrone-remote-desktop. "gnome" is the session GDM falls back to for
# accounts with no valid session of their own (Ubuntu's ubuntu.desktop is
# moved aside), so every account gets Patrone Desktop. libexec/session runs
# the screen's viewer when the session has a seat, and the account's GNOME
# desktop when it has none (GDM's background desktop, hence
# X-GDM-CanRunHeadless). The desktop names are Ubuntu's session's, for its
# settings. GDM registers the session as soon as it starts (no
# X-GDM-SessionRegisters), since the viewer doesn't register itself.
Name=Patrone Desktop
Comment=Your desktop: the same one Remote Desktop connects to
Exec=/usr/libexec/patrone-remote-desktop/session
TryExec=/usr/bin/gnome-session
Type=Application
DesktopNames=ubuntu;GNOME
X-GDM-CanRunHeadless=true
