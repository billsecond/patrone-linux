[Unit]
Description=Patrone Remote Desktop's login screen for Hyper-V's enhanced session
CollectMode=inactive-or-failed

[Service]
User=patrone-vmconnect
Group=patrone-vmconnect
ExecStart=/usr/libexec/patrone-remote-desktop/greeter
StandardInput=socket
StandardOutput=journal
StandardError=journal
SyslogIdentifier=patrone-remote-desktop-greeter
# It ends itself after 15 minutes with nobody signing in.
RuntimeMaxSec=2h
# The certificate, shared with the proxy
StateDirectory=patrone-remote-desktop/vmconnect
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
