# Signing in to Hyper-V's enhanced session (patrone-remote-desktop's login
# screen in VMConnect): any account that may sign in at the computer, with
# its own password. Only the Hyper-V host can reach it, as only someone at the
# computer can reach its own screen.
auth     requisite  pam_nologin.so
auth     requisite  pam_succeed_if.so uid >= 1000 quiet
auth     optional   pam_faildelay.so delay=2000000
@include common-auth
@include common-account
