[Desktop Entry]
# The GNOME session each account's one desktop runs, without a monitor, for
# the screen's Patrone Desktop session and Remote Desktop to show. Hidden from
# the login screen's menu (NoDisplay, which only the menu reads); GDM starts it
# for background desktops (X-GDM-CanRunHeadless). It replaces Ubuntu's
# ubuntu.desktop, which patrone-remote-desktop moves aside.
Name=Patrone desktop (background)
Comment=The GNOME session behind Patrone Desktop and Remote Desktop
Exec=/usr/bin/gnome-session --session=ubuntu
TryExec=/usr/bin/gnome-session
Type=Application
DesktopNames=ubuntu;GNOME
X-GDM-SessionRegisters=true
X-GDM-CanRunHeadless=true
NoDisplay=true
