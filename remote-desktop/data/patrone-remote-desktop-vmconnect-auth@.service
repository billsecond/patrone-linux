[Unit]
Description=Patrone Remote Desktop's sign-in check for Hyper-V's enhanced session
CollectMode=inactive-or-failed

[Service]
# Root: it checks any account's password, and starts the account's desktop.
ExecStart=/usr/libexec/patrone-remote-desktop/auth --vmconnect
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=patrone-remote-desktop-auth
TimeoutSec=180
