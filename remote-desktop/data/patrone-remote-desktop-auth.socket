[Unit]
Description=Patrone Remote Desktop sign-in checks

[Socket]
# Only the proxy (group patrone-rdp) can ask.
ListenStream=/run/patrone-remote-desktop/auth.sock
SocketUser=root
SocketGroup=patrone-rdp
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
