[Unit]
Description=Patrone desktops for the machine's own screen

[Socket]
# Any account may ask, for its own desktop only: the helper takes the
# account from the connection (SO_PEERCRED), not from anything sent.
ListenStream=/run/patrone-remote-desktop/console.sock
SocketMode=0666
DirectoryMode=0755
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
