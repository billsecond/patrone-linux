[Unit]
Description=Patrone Remote Desktop's login screen for Hyper-V's enhanced session
ConditionVirtualization=microsoft

[Socket]
# Only the enhanced session's proxy (patrone-vmconnect) connects here.
ListenStream=/run/patrone-remote-desktop/greeter.sock
SocketUser=patrone-vmconnect
SocketGroup=patrone-vmconnect
SocketMode=0600
DirectoryMode=0755
Accept=yes
MaxConnections=8
