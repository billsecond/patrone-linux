[Unit]
Description=Patrone Remote Desktop's sign-in checks for Hyper-V's enhanced session
ConditionVirtualization=microsoft

[Socket]
# Only the enhanced session's login screen (group patrone-vmconnect) can ask.
ListenStream=/run/patrone-remote-desktop/vmconnect-auth.sock
SocketUser=root
SocketGroup=patrone-vmconnect
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=8
