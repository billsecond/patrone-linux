// Patrone's desktops run with no seat: the machine's own screen and Remote
// Desktop clients all show them through GNOME Remote Desktop (see
// /usr/share/doc/patrone-remote-desktop/README.md). polkit counts a session
// as local only when it has a seat, so it treated these desktops like SSH
// logins: the quick settings' network menu wouldn't open (its permission,
// network-control, is "yes" only for local sessions) and shutting down
// asked for an administrator's password.
//
// This gives a graphical session with no seat what a desktop at the
// machine's own screen gets without a password (allow_active "yes" in each
// action's defaults, or what Ubuntu's own rules give administrators there),
// and installing software with one password, for the actions below only.
// SSH logins and other text sessions, and every other action, are left to
// the defaults.

var patroneDesktopActions = [
    "org.freedesktop.NetworkManager.enable-disable-network",
    "org.freedesktop.NetworkManager.enable-disable-wifi",
    "org.freedesktop.NetworkManager.enable-disable-wwan",
    "org.freedesktop.NetworkManager.enable-disable-wimax",
    "org.freedesktop.NetworkManager.network-control",
    "org.freedesktop.NetworkManager.wifi.scan",
    "org.freedesktop.NetworkManager.wifi.share.protected",
    "org.freedesktop.NetworkManager.wifi.share.open",
    "org.freedesktop.NetworkManager.settings.modify.own",
    "org.freedesktop.NetworkManager.enable-disable-statistics",
    "org.freedesktop.NetworkManager.enable-disable-connectivity-check",
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.reboot",
    "org.freedesktop.login1.suspend",
    "org.freedesktop.udisks2.filesystem-mount",
    "org.freedesktop.udisks2.encrypted-unlock",
    "org.freedesktop.udisks2.eject-media",
    "org.freedesktop.udisks2.power-off-drive",
    // Patrone Software (GNOME Software) refreshing and updating Flatpak
    // apps and apt's lists: at first login it asked for a password to
    // "update information about software" (2026-10-27)
    "org.freedesktop.Flatpak.app-update",
    "org.freedesktop.Flatpak.runtime-update",
    "org.freedesktop.Flatpak.update-remote",
    "org.freedesktop.Flatpak.modify-repo",
    "org.freedesktop.Flatpak.appstream-update",
    "org.freedesktop.Flatpak.metadata-update",
    "org.freedesktop.Flatpak.override-parental-controls-update",
    "org.freedesktop.packagekit.system-sources-refresh",
    "org.freedesktop.packagekit.system-network-proxy-configure",
    "org.freedesktop.packagekit.trigger-offline-update",
    "org.freedesktop.packagekit.clear-offline-update"
];

// Ubuntu also lets administrators at the screen change system-wide
// connections (org.freedesktop.NetworkManager.rules)
var patroneDesktopAdminActions = [
    "org.freedesktop.NetworkManager.settings.modify.system"
];

// Installing, removing and updating software asks for a password once, and
// that password is remembered for a few minutes and covers what the action
// implies: an app's install covers its runtimes and their extensions
// (allow_active "auth_admin_keep", as at the screen). Without a seat,
// polkit gave these "auth_admin", a password for every step: installing
// MailCraft asked at least 30 times (2026-10-28; the user: "suppress it
// down to a single one"). Ubuntu's own rules let administrators at the
// screen do some of these with no password at all; Patrone's desktops ask
// once.
var patroneDesktopOnceActions = [
    "org.freedesktop.Flatpak.app-install",
    "org.freedesktop.Flatpak.runtime-install",
    "org.freedesktop.Flatpak.install-bundle",
    "org.freedesktop.Flatpak.app-uninstall",
    "org.freedesktop.Flatpak.runtime-uninstall",
    "org.freedesktop.Flatpak.configure-remote",
    "org.freedesktop.packagekit.package-install",
    "org.freedesktop.packagekit.package-reinstall",
    "org.freedesktop.packagekit.system-update",
    "org.freedesktop.packagekit.system-sources-configure",
    "org.freedesktop.packagekit.trigger-offline-upgrade",
    "io.snapcraft.snapd.manage"
];

// A graphical session (Wayland or X11) with no seat, active: one of
// Patrone's desktops
function patroneSessionIsDesktop(session) {
    try {
        var lines = polkit.spawn(["/usr/bin/loginctl", "show-session", session,
            "--property=Type", "--property=Seat", "--property=Active"]).split("\n");
        var props = {};
        for (var i = 0; i < lines.length; i++) {
            var at = lines[i].indexOf("=");
            if (at > 0)
                props[lines[i].slice(0, at)] = lines[i].slice(at + 1).trim();
        }
        return (props.Type === "wayland" || props.Type === "x11") &&
            !props.Seat && props.Active === "yes";
    } catch (e) {
        return false;
    }
}

function patroneIsDesktop(subject) {
    if (subject.local)
        return false;
    if (subject.session)
        return subject.active && !subject.seat && patroneSessionIsDesktop(subject.session);

    // GNOME 50 runs the desktop's shell and services as units of the
    // account's own service manager (org.gnome.Shell@ubuntu.service, in its
    // session.slice), outside the login session, so polkit gives them no
    // session at all and the rule above never matched: the quick settings'
    // Wired menu still wouldn't open (2026-10-26). For a process with no
    // session, one of the account's desktop services, in its session.slice,
    // counts when the account's display session is a desktop as above. So
    // does one of its apps, in its app.slice: apps opened from the desktop,
    // and Patrone Software's background service (gnome-software.service).
    try {
        var cgroup = polkit.spawn(["/usr/bin/cat", "/proc/" + subject.pid + "/cgroup"]);
        var uid = polkit.spawn(["/usr/bin/id", "-u", subject.user]).trim();
        if (cgroup.indexOf("/user@" + uid + ".service/session.slice/") < 0 &&
            cgroup.indexOf("/user@" + uid + ".service/app.slice/") < 0)
            return false;
        var display = polkit.spawn(["/usr/bin/loginctl", "show-user", subject.user,
            "--property=Display", "--value"]).trim();
        return display !== "" && patroneSessionIsDesktop(display);
    } catch (e) {
        return false;
    }
}

polkit.addRule(function (action, subject) {
    var free = patroneDesktopActions.indexOf(action.id) >= 0 ||
        (patroneDesktopAdminActions.indexOf(action.id) >= 0 &&
         (subject.isInGroup("sudo") || subject.isInGroup("netdev")));
    var once = patroneDesktopOnceActions.indexOf(action.id) >= 0;
    if ((free || once) && patroneIsDesktop(subject))
        return free ? polkit.Result.YES : polkit.Result.AUTH_ADMIN_KEEP;
    return polkit.Result.NOT_HANDLED;
});
