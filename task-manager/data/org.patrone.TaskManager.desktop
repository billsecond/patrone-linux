[Desktop Entry]
Type=Application
Name=Task Manager
X-GNOME-FullName=Patrone Task Manager
GenericName=Task Manager
Comment=See the apps and processes running and end them, and how hard the computer is working
Keywords=process;processes;task;tasks;kill;end;cpu;memory;disk;network;performance;monitor;startup;services;system;
Exec=patrone-task-manager
Icon=org.patrone.TaskManager
Terminal=false
StartupNotify=true
Categories=GTK;System;Monitor;
Actions=performance;startup;services;

[Desktop Action performance]
Name=Performance
Exec=patrone-task-manager --page performance

[Desktop Action startup]
Name=Startup applications
Exec=patrone-task-manager --page startup

[Desktop Action services]
Name=Services
Exec=patrone-task-manager --page services
