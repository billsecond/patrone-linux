<?xml version="1.0" encoding="UTF-8"?>
<!--
  Patrone's picks for GNOME Software, installed as
  /usr/share/swcatalog/xml/org.patrone.Software.Featured.xml by
  patrone-software, in place of GNOME's list (see README.md).

  Each app is its AppStream ID, as Ubuntu's archive or a Flatpak remote
  (Flathub) knows it, with up to three marks (GNOME's gnome-app-list README):
    GnomeSoftware::FeatureTile    the banners at the top of Explore (5 or more)
    kudo GnomeSoftware::popular   Editor's Choice on Explore (6 or more)
    category Featured             the picks on its category's page (3 or more
                                  in a category)
  An app that no catalog GNOME Software reads has is left out, so an app
  listed here shows as soon as one has it.
-->
<components>
  <!--
    The Craft apps (the user's list, 2026-10-27): storytold's Crafting Apps
    (github.com/storytold, getartcraft.com), most popular first by GitHub
    stars, then ScreenGrabCraft and MailCraft. None is in Ubuntu's archive
    or on Flathub yet: they're .deb, .flatpak and AppImage files on their
    GitHub releases, which GNOME Software doesn't read. They show once
    they're in a Flatpak repository it does (README.md). ArtCraft itself
    has no Linux build (macOS, Windows and the web), so it isn't listed.
  -->
  <component merge="append">
    <id>ai.storyteller.photocraft</id>
    <categories><category>Featured</category></categories>
    <kudos><kudo>GnomeSoftware::popular</kudo></kudos>
    <custom><value key="GnomeSoftware::FeatureTile">True</value></custom>
  </component>
