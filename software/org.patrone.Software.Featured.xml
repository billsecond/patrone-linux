<?xml version="1.0" encoding="UTF-8"?>
<!--
  Patrone's picks for GNOME Software, installed as
  /usr/share/swcatalog/xml/org.patrone.Software.Featured.xml by
  patrone-software, in place of GNOME's list (see README.md).

  Each app is its AppStream ID, as Ubuntu's archive or a Flatpak remote
  (Flathub, Patrone's app index) knows it, with two marks:
    GnomeSoftware::DeploymentFeatured = patrone
                                  the Featured tab (Patrone's build of GNOME
                                  Software, gnome-software/ in this repository)
    category Featured             the picks on its category's page (3 or more
                                  in a category)
  GNOME's other two marks, GnomeSoftware::FeatureTile and the
  GnomeSoftware::popular kudo, fill Explore's banners and Editor's Choice.
  They're left out so these apps show once, on the Featured tab.
  An app that no catalog GNOME Software reads has is left out, so an app
  listed here shows as soon as one has it.
-->
<components>
  <!--
    The user's list, 2026-10-31: "feature only for now" these. They stay in
    Explore, its categories and search, like every other app.

    The ArtCraft Launcher isn't here until the ArtCraft Team allows its icon
    (docs/COMPLIANCE.md, item 6).
  -->
  <component merge="append">
    <id>io.github.billsecond.mailcraft</id>
    <categories><category>Featured</category></categories>
    <custom><value key="GnomeSoftware::DeploymentFeatured">patrone</value></custom>
  </component>
  <component merge="append">
    <id>ai.storyteller.pdfcraft</id>
    <categories><category>Featured</category></categories>
    <custom><value key="GnomeSoftware::DeploymentFeatured">patrone</value></custom>
  </component>
  <!--
    Teams for Linux, the unofficial Microsoft Teams app (the user, 2026-10-28:
    "sudo snap install teams-for-linux"). Patrone Software shows no snaps,
    so it's the same project's Flathub build, which Flathub calls "Portal
    for Teams".
  -->
  <component merge="append">
    <id>com.github.IsmaelMartinez.teams_for_linux</id>
    <categories><category>Featured</category></categories>
    <custom><value key="GnomeSoftware::DeploymentFeatured">patrone</value></custom>
  </component>
  <component merge="append">
    <id>ai.storyteller.wordcraft</id>
    <categories><category>Featured</category></categories>
    <custom><value key="GnomeSoftware::DeploymentFeatured">patrone</value></custom>
  </component>
  <component merge="append">
    <id>ai.storyteller.gridcraft</id>
    <categories><category>Featured</category></categories>
    <custom><value key="GnomeSoftware::DeploymentFeatured">patrone</value></custom>
  </component>
  <component merge="append">
    <id>io.github.billsecond.screengrabcraft</id>
    <categories><category>Featured</category></categories>
    <custom><value key="GnomeSoftware::DeploymentFeatured">patrone</value></custom>
  </component>
</components>
