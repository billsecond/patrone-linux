[Desktop Entry]
# Opens Patrone Terminal when you log in. To stop it for one user, copy this
# file to ~/.config/autostart/ and add Hidden=true.
Type=Application
Name=Patrone Terminal
Comment=Open a terminal when you log in
# After the first-login setup, on an account's first login
Exec=/usr/libexec/patrone-terminal/patrone-terminal-autostart
Icon=org.patrone.Terminal
Terminal=false
