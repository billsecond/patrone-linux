#!/bin/sh
# Opens Patrone Terminal at login (org.patrone.Terminal.desktop in
# /etc/xdg/autostart). On an account's first login GNOME's first-login setup
# (gnome-initial-setup-first-login.service, until gnome-initial-setup-done is
# in the account's config folder) runs too: the terminal waits until it has
# closed, so it doesn't cover the setup's pages. Setup starts alongside this,
# so it gets a few seconds to appear.
done_file=${XDG_CONFIG_HOME:-$HOME/.config}/gnome-initial-setup-done

if [ ! -e "$done_file" ] && [ -e /usr/lib/systemd/user/gnome-initial-setup-first-login.service ]; then
    waited=0
    while [ "$waited" -lt 20 ] && ! pgrep -u "$(id -u)" -f /usr/libexec/gnome-initial-setup >/dev/null; do
        sleep 1
        waited=$((waited + 1))
    done
    while pgrep -u "$(id -u)" -f /usr/libexec/gnome-initial-setup >/dev/null; do
        sleep 2
    done
fi
exec patrone-terminal
