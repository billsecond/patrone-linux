# ~/.bash_aliases: Ubuntu's ~/.bashrc loads this file after setting up bash,
# so Patrone's prompt goes here rather than replacing ~/.bashrc. Add your own
# aliases below.

# Patrone's prompt (patrone-shell-config)
if [ -r ~/.local/share/patrone/bashrc ]; then
    . ~/.local/share/patrone/bashrc
elif [ -r /usr/share/patrone/bashrc ]; then
    . /usr/share/patrone/bashrc
fi
