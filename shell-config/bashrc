# PatroneOS's bash prompt, loaded from ~/.bash_aliases (see bash_aliases).
#
# The prompt takes two lines:
#   ┌──(user㉿host)-[~/src]
#   └─$
# The frame is blue, or red for root. A failed command's exit status goes on
# its own line under the command, in front of the prompt, so it isn't taken
# for the next command's. It shows once, after a command that ran, and not
# after an empty line or an unfinished one.

# Only for interactive shells
[[ $- == *i* ]] || return

__patrone_prompt() {
    local status=$?
    local frame='\[\e[34m\]' name='\[\e[1;94m\]' symbol='$'
    if ((EUID == 0)); then
        frame='\[\e[31m\]' name='\[\e[1;91m\]' symbol='#'
    fi
    local reset='\[\e[0m\]' bold='\[\e[1m\]'
    local title='\[\e]0;\u@\h: \w\a\]'
    local venv='' failed=''
    if [[ -n $VIRTUAL_ENV ]]; then
        venv="(${VIRTUAL_ENV##*/})─"
    fi
    if ((status != 0 && __patrone_ran)); then
        failed="\[\e[31m\]✗ exit code ${status}${reset}\n"
    fi
    __patrone_ran=0
    PS1="${failed}${title}${frame}┌──${venv}(${name}\u㉿\h${reset}${frame})-[${reset}${bold}\w${reset}${frame}]${reset}\n${frame}└─${name}${symbol}${reset} "
    __patrone_report_directory
    return "$status"
}

# Tells the terminal the current directory (OSC 7), so a new tab opens there.
__patrone_report_directory() {
    local LC_ALL=C url='' char i
    for ((i = 0; i < ${#PWD}; i++)); do
        char=${PWD:i:1}
        case $char in
            [-/:_.~a-zA-Z0-9]) url+=$char ;;
            *) printf -v char '%%%02X' "'$char" && url+=$char ;;
        esac
    done
    printf '\e]7;file://%s%s\e\\' "$HOSTNAME" "$url"
}

# Python virtual environments show up in the prompt instead.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# First, so it sees the last command's exit status.
if [[ $PROMPT_COMMAND != *__patrone_prompt* ]]; then
    PROMPT_COMMAND="__patrone_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi

# bash expands PS0 when it's about to run a command, and not for an empty line,
# so this notes that one ran. It prints nothing: it's an empty part of PS1, with
# the note made while working out where that part starts.
__patrone_ran=0
if [[ $PS0 != *__patrone_ran* ]]; then
    PS0+='${PS1:$((__patrone_ran=1, 0)):0}'
fi
