# Patrone Linux's bash prompt, loaded from ~/.bash_aliases (see bash_aliases).
#
# The prompt takes two lines:
#   ┌──(user㉿host)-[~/src]
#   └─$
# The frame is blue, or red for root. A failed command's exit status shows at
# the end of the first line.

# Only for interactive shells
[[ $- == *i* ]] || return

__patrone_prompt() {
    local status=$?
    local frame='\[\e[34m\]' name='\[\e[1;94m\]' symbol='$'
    if ((EUID == 0)); then
        frame='\[\e[31m\]' name='\[\e[1;91m\]' symbol='#'
    fi
    local reset='\[\e[0m\]' bold='\[\e[1m\]'
    local title='\[\e]0;\u@\h: \w\a\]'
    local venv='' failed=''
    if [[ -n $VIRTUAL_ENV ]]; then
        venv="(${VIRTUAL_ENV##*/})─"
    fi
    if ((status != 0)); then
        failed=" \[\e[31m\]${status} ✗${reset}"
    fi
    PS1="${title}${frame}┌──${venv}(${name}\u㉿\h${reset}${frame})-[${reset}${bold}\w${reset}${frame}]${failed}${reset}\n${frame}└─${name}${symbol}${reset} "
    __patrone_report_directory
    return "$status"
}

# Tells the terminal the current directory (OSC 7), so a new tab opens there.
__patrone_report_directory() {
    local LC_ALL=C url='' char i
    for ((i = 0; i < ${#PWD}; i++)); do
        char=${PWD:i:1}
        case $char in
            [-/:_.~a-zA-Z0-9]) url+=$char ;;
            *) printf -v char '%%%02X' "'$char" && url+=$char ;;
        esac
    done
    printf '\e]7;file://%s%s\e\\' "$HOSTNAME" "$url"
}

# Python virtual environments show up in the prompt instead.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# First, so it sees the last command's exit status.
if [[ $PROMPT_COMMAND != *__patrone_prompt* ]]; then
    PROMPT_COMMAND="__patrone_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi
