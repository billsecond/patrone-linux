#!/bin/sh
# /usr/lib/command-not-found on PatroneOS. bash (/etc/bash.bashrc) and zsh
# (/etc/zsh_command_not_found) both run this when a command isn't found, for
# every account, old or new. Ubuntu's own program is at
# /usr/lib/command-not-found.ubuntu (see debian/preinst).
#
# A Windows command from windows-commands.tsv gets the Linux command to use.
# Anything else goes on to Ubuntu's program, which may suggest a package. It
# only ever prints: it runs nothing, and a program with that name always runs
# first, since the shell only comes here when it finds none.
#
# Both shells pass the command's name and leave out its arguments, so what's
# printed for "ipconfig" and "ipconfig /all" is the same, and the table lists
# each command's usual options for that reason.

table=/usr/share/patrone/windows-commands.tsv
ubuntu=/usr/lib/command-not-found.ubuntu

# The name is the last argument: both shells call this as "-- NAME"
name=
for name; do :; done

red=
green=
plain=
if [ -t 2 ] && [ "${TERM:-dumb}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
    red=$(printf '\033[1;91m')
    green=$(printf '\033[1;92m')
    plain=$(printf '\033[0m')
fi

if [ -r "$table" ] && NAME=$name RED=$red GREEN=$green PLAIN=$plain awk -F '\t' '
    BEGIN {
        typed = ENVIRON["NAME"]
        wanted = tolower(typed)
        sub(/\.exe$/, "", wanted)
    }
    /^#/ || NF < 2 { next }
    {
        count = split(tolower($1), names, " ")
        for (i = 1; i <= count; i++) {
            if (names[i] == wanted) {
                found = 1
                exit
            }
        }
    }
    END {
        if (!found) exit 1
        red = ENVIRON["RED"]; green = ENVIRON["GREEN"]; plain = ENVIRON["PLAIN"]
        printf "%sInvalid command:%s %s\n", red, plain, typed
        print "That'\''s a Windows command. The Linux command you might be looking for is:"
        printf "\n    %s%s%s\n", green, $2, plain
        # The rest of the row: "OPTION=WHAT TO USE", or a plain sentence
        width = 0
        for (i = 3; i <= NF; i++) {
            if ($i ~ /^[^ =]+=/) {
                option[i] = substr($i, 1, index($i, "=") - 1)
                if (length(option[i]) > width) width = length(option[i])
            }
        }
        if (NF > 2) print ""
        format = "%s %-" width "s  %s\n"
        for (i = 3; i <= NF; i++) {
            if (i in option) {
                printf format, typed, option[i], substr($i, index($i, "=") + 1)
            } else {
                print $i
            }
        }
    }' "$table" >&2; then
    exit 127
fi

if [ -x "$ubuntu" ]; then
    exec "$ubuntu" "$@"
fi
printf '%s: command not found\n' "$name" >&2
exit 127
