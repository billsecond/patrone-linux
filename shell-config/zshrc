# PatroneOS's default zsh setup, installed as /etc/skel/.zshrc.
#
# The prompt takes two lines:
#   ┌──(user㉿host)-[~/src]
#   └─$
# The frame is blue, or red for root.

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history hist_ignore_dups hist_ignore_space hist_verify share_history

# Behaviour
setopt autocd interactive_comments no_beep prompt_subst
WORDCHARS=${WORDCHARS//\/}  # Ctrl+W and Ctrl+Backspace stop at slashes

# Keys: Emacs-style editing, plus the keys people expect from other terminals
bindkey -e
bindkey '^[[H' beginning-of-line       # Home
bindkey '^[[F' end-of-line             # End
bindkey '^[[3~' delete-char            # Delete
bindkey '^[[1;5C' forward-word         # Ctrl+Right
bindkey '^[[1;5D' backward-word        # Ctrl+Left
bindkey '^H' backward-kill-word        # Ctrl+Backspace
bindkey '^[[3;5~' kill-word            # Ctrl+Delete
bindkey '^[[Z' undo                    # Shift+Tab

# Colors for ls, grep and completion lists
if [[ -x /usr/bin/dircolors ]]; then
    eval "$(dircolors -b)"
fi
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lAh'
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip --color=auto'

# Completion
autoload -Uz compinit
mkdir -p ~/.cache/zsh
compinit -d ~/.cache/zsh/zcompdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' rehash true

# Prompt. Python virtual environments show up in the first line.
VIRTUAL_ENV_DISABLE_PROMPT=1
() {
    local frame=blue name=12 symbol='$'
    if (( EUID == 0 )); then
        frame=red name=9 symbol='#'
    fi
    PROMPT="%(1V.%F{red}✗ exit code %1v%f"$'\n'".)%F{$frame}┌──\${VIRTUAL_ENV:+(\${VIRTUAL_ENV:t})─}(%B%F{$name}%n㉿%m%b%F{$frame})-[%B%f%(6~.%-1~/…/%4~.%5~)%b%F{$frame}]"$'\n'"└─%B%F{$name}$symbol%b%f "
}
# The number of background jobs
RPROMPT='%(1j.%F{yellow}%j⚙%f.)'

# Tell the terminal its title and the current directory, so a new tab opens
# in the same directory (OSC 7).
_patrone_report_directory() {
    setopt local_options no_multibyte
    local LC_ALL=C char url
    local -i i
    for (( i = 1; i <= ${#PWD}; i++ )); do
        char=${PWD[i]}
        case $char in
            [-/:_.~[:alnum:]]) url+=$char ;;
            *) url+=$(printf '%%%02X' "'$char") ;;
        esac
    done
    printf '\e]7;file://%s%s\e\\' "$HOST" "$url"
}
# A failed command's exit status goes on its own line under the command, in
# front of the prompt, so it isn't taken for the next command's. It shows once,
# after a command that ran, and not after an empty line or an unfinished one.
_patrone_ran=
_patrone_precmd() {
    local code=$?
    psvar[1]=
    if [[ -n $_patrone_ran ]] && (( code != 0 )); then
        psvar[1]=$code
    fi
    _patrone_ran=
    print -Pn '\e]2;%n@%m: %~\a'
    _patrone_report_directory
}
_patrone_preexec() {
    _patrone_ran=1
    print -rn -- $'\e]2;'"${1//[[:cntrl:]]/ }"$'\a'
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _patrone_precmd
add-zsh-hook preexec _patrone_preexec

# Suggest packages for unknown commands
if [[ -r /etc/zsh_command_not_found ]]; then
    source /etc/zsh_command_not_found
fi

# Suggestions from history as you type (→ accepts them), then syntax
# highlighting, which has to be loaded last.
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
fi
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
