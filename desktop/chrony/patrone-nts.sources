# Patrone's time servers, in place of Ubuntu's ntp.ubuntu.com pools: four
# operators other than Canonical (Cloudflare, Netnod, PTB and SIDN Labs),
# each authenticated with NTS.
server time.cloudflare.com iburst nts
server nts.netnod.se iburst nts
server ptbtime1.ptb.de iburst nts
server ntppool1.time.nl iburst nts
