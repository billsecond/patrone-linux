[Desktop Entry]
Type=Application
Name=File Manager
X-GNOME-FullName=Patrone File Manager
GenericName=File Manager
Comment=Browse and organize your files
Keywords=folder;files;explorer;manager;browse;documents;
Exec=patrone-file-manager %U
Icon=org.patrone.FileManager
Terminal=false
StartupNotify=true
Categories=GTK;System;FileTools;FileManager;Core;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=patrone-file-manager --new-window
