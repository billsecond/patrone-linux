+                              </object>
+                            </child>
+
+                            <child>
+                              <object class="GtkLabel" id="featured_heading">
+                                <property name="xalign">0</property>
+                                <property name="label" translatable="yes" comments="Translators: This is a heading for the apps the distribution features.">Featured Apps</property>
+                                <property name="margin-top">21</property>
+                                <property name="margin-bottom">6</property>
+                                <style>
+                                  <class name="heading"/>
+                                </style>
+                              </object>
+                            </child>
+                            <child>
+                              <object class="GtkFlowBox" id="box_featured">
+                                <property name="homogeneous">True</property>
+                                <property name="column-spacing">14</property>
+                                <property name="row-spacing">14</property>
+                                <property name="valign">start</property>
+                                <property name="selection-mode">none</property>
+                                <signal name="child-activated" handler="app_activated_cb" swapped="yes"/>
+                                <accessibility>
+                                  <relation name="labelled-by">featured_heading</relation>
+                                </accessibility>
+                              </object>
+                            </child>
+
+                          </object>
+                        </child>
+                      </object>
+                    </child>
