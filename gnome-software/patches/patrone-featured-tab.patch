--- a/src/gs-featured-page.c
+++ b/src/gs-featured-page.c
@@ -0,0 +1,306 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: t; c-basic-offset: 8 -*-
+ * vi:set noexpandtab tabstop=8 shiftwidth=8:
+ *
+ * The Featured tab: every app the distribution's list marks with
+ * GnomeSoftware::DeploymentFeatured and the key below, in banners and tiles.
+ * Explore can't show a short list whole: it keeps five banners, and trims
+ * Editor's Choice to a multiple of six.
+ *
+ * Adapted from gs-overview-page.c:
+ * Copyright (C) 2013-2017 Richard Hughes <richard@hughsie.com>
+ * Copyright (C) 2014-2018 Kalev Lember <klember@redhat.com>
+ * Copyright (C) 2026 William Daugherty
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "config.h"
+
+#include <adwaita.h>
+#include <glib/gi18n.h>
+
+#include "gs-shell.h"
+#include "gs-featured-page.h"
+#include "gs-app-list-private.h"
+#include "gs-common.h"
+#include "gs-featured-carousel.h"
+#include "gs-summary-tile.h"
+
+/* Tiles to show until the list arrives */
+#define N_PLACEHOLDER_TILES 6
+
+/* The size of icon GsFeatureTile needs */
+#define BANNER_ICON_SIZE 128
+
+static const gchar * const featured_keys[] = { "patrone", NULL };
+
+struct _GsFeaturedPage
+{
+	GsPage			 parent_instance;
+
+	GsPluginLoader		*plugin_loader;
+	GCancellable		*cancellable;
+	gboolean		 cache_valid;
+	gboolean		 loading;
+	GsShell			*shell;
+
+	GtkWidget		*featured_carousel;
+	GtkWidget		*box_featured;
+	GtkWidget		*scrolledwindow_featured;
+	GtkWidget		*stack_featured;
+};
+
+G_DEFINE_TYPE (GsFeaturedPage, gs_featured_page, GS_TYPE_PAGE)
+
+typedef enum {
+	PROP_VADJUSTMENT = 1,
+	PROP_TITLE,
+} GsFeaturedPageProperty;
+
+static void
+app_activated_cb (GsFeaturedPage *self, GsAppTile *tile)
+{
+	GsApp *app;
+
+	app = gs_app_tile_get_app (tile);
+
+	if (!app)
+		return;
+
+	gs_shell_show_app (self->shell, app);
+}
+
+static void
+featured_carousel_app_clicked_cb (GsFeaturedCarousel *carousel,
+                                  GsApp              *app,
+                                  gpointer            user_data)
+{
+	GsFeaturedPage *self = GS_FEATURED_PAGE (user_data);
+
+	gs_shell_show_app (self->shell, app);
+}
+
+static void
+gs_featured_page_get_apps_cb (GObject *source_object,
+                              GAsyncResult *res,
+                              gpointer user_data)
+{
+	g_autoptr(GsFeaturedPage) self = GS_FEATURED_PAGE (user_data);
+	GsPluginLoader *plugin_loader = GS_PLUGIN_LOADER (source_object);
+	g_autoptr(GError) error = NULL;
+	g_autoptr(GsPluginJobListApps) list_apps_job = NULL;
+	g_autoptr(GsAppList) banners = gs_app_list_new ();
+	GsAppList *list = NULL;
+
+	self->loading = FALSE;
+
+	if (!gs_plugin_loader_job_process_finish (plugin_loader, res, (GsPluginJob **) &list_apps_job, &error)) {
+		if (g_error_matches (error, GS_PLUGIN_ERROR, GS_PLUGIN_ERROR_CANCELLED) ||
+		    g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+			return;
+		g_warning ("failed to get featured apps: %s", error->message);
+	} else {
+		list = gs_plugin_job_list_apps_get_result_list (list_apps_job);
+	}
+
+	self->cache_valid = TRUE;
+
+	if (list == NULL || gs_app_list_length (list) == 0) {
+		gtk_stack_set_visible_child_name (GTK_STACK (self->stack_featured), "no-results");
+		return;
+	}
+
+	gs_widget_remove_all (self->box_featured, (GsRemoveFunc) gtk_flow_box_remove);
+
+	for (guint i = 0; i < gs_app_list_length (list); i++) {
+		GsApp *app = gs_app_list_index (list, i);
+		g_autoptr(GIcon) icon = NULL;
+
+		gtk_flow_box_insert (GTK_FLOW_BOX (self->box_featured), gs_summary_tile_new (app), -1);
+
+		icon = gs_app_get_icon_for_size (app,
+						 BANNER_ICON_SIZE,
+						 gtk_widget_get_scale_factor (GTK_WIDGET (self)),
+						 NULL);
+		if (icon != NULL)
+			gs_app_list_add (banners, app);
+	}
+
+	gtk_widget_set_visible (self->featured_carousel, gs_app_list_length (banners) > 0);
+	gs_featured_carousel_set_apps (GS_FEATURED_CAROUSEL (self->featured_carousel), banners);
+
+	gtk_stack_set_visible_child_name (GTK_STACK (self->stack_featured), "featured");
+}
+
+static void
+gs_featured_page_load (GsFeaturedPage *self)
+{
+	g_autoptr(GsPluginJob) plugin_job = NULL;
+	g_autoptr(GsAppQuery) query = NULL;
+	GsPluginListAppsFlags flags = GS_PLUGIN_LIST_APPS_FLAGS_INTERACTIVE;
+
+	if (self->loading)
+		return;
+
+	query = gs_app_query_new ("deployment-featured", featured_keys,
+				  "refine-require-flags", GS_PLUGIN_REFINE_REQUIRE_FLAGS_RATING |
+							  GS_PLUGIN_REFINE_REQUIRE_FLAGS_CATEGORIES |
+							  GS_PLUGIN_REFINE_REQUIRE_FLAGS_ICON,
+				  "dedupe-flags", GS_APP_LIST_FILTER_FLAG_PREFER_INSTALLED |
+						  GS_APP_LIST_FILTER_FLAG_KEY_ID_PROVIDES,
+				  "sort-func", gs_utils_app_sort_name,
+				  "license-type", gs_page_get_query_license_type (GS_PAGE (self)),
+				  "developer-verified-type", gs_page_get_query_developer_verified_type (GS_PAGE (self)),
+				  NULL);
+
+	plugin_job = gs_plugin_job_list_apps_new (query, flags);
+
+	self->loading = TRUE;
+	gs_plugin_loader_job_process_async (self->plugin_loader,
+					    plugin_job,
+					    self->cancellable,
+					    gs_featured_page_get_apps_cb,
+					    g_object_ref (self));
+}
+
+static void
+gs_featured_page_reload (GsPage *page)
+{
+	GsFeaturedPage *self = GS_FEATURED_PAGE (page);
+
+	self->cache_valid = FALSE;
+	gs_featured_page_load (self);
+}
+
+static void
+gs_featured_page_switch_to (GsPage *page)
+{
+	GsFeaturedPage *self = GS_FEATURED_PAGE (page);
+
+	if (gs_shell_get_mode (self->shell) != GS_SHELL_MODE_FEATURED) {
+		g_warning ("Called switch_to(featured) when in mode %s",
+			   gs_shell_get_mode_string (self->shell));
+		return;
+	}
+
+	gs_grab_focus_when_mapped (self->scrolledwindow_featured);
+
+	if (!self->cache_valid)
+		gs_featured_page_load (self);
+}
+
+static gboolean
+gs_featured_page_setup (GsPage *page,
+                        GsShell *shell,
+                        GsPluginLoader *plugin_loader,
+                        GCancellable *cancellable,
+                        GError **error)
+{
+	GsFeaturedPage *self = GS_FEATURED_PAGE (page);
+
+	g_return_val_if_fail (GS_IS_FEATURED_PAGE (self), TRUE);
+
+	self->plugin_loader = g_object_ref (plugin_loader);
+	self->cancellable = g_object_ref (cancellable);
+
+	/* avoid a ref cycle */
+	self->shell = shell;
+
+	for (guint i = 0; i < N_PLACEHOLDER_TILES; i++)
+		gtk_flow_box_insert (GTK_FLOW_BOX (self->box_featured), gs_summary_tile_new (NULL), -1);
+
+	return TRUE;
+}
+
+static void
+gs_featured_page_init (GsFeaturedPage *self)
+{
+	g_type_ensure (GS_TYPE_FEATURED_CAROUSEL);
+
+	gtk_widget_init_template (GTK_WIDGET (self));
+}
+
+static void
+gs_featured_page_get_property (GObject    *object,
+                               guint       prop_id,
+                               GValue     *value,
+                               GParamSpec *pspec)
+{
+	GsFeaturedPage *self = GS_FEATURED_PAGE (object);
+
+	switch ((GsFeaturedPageProperty) prop_id) {
+	case PROP_VADJUSTMENT:
+		g_value_set_object (value, gtk_scrolled_window_get_vadjustment (GTK_SCROLLED_WINDOW (self->scrolledwindow_featured)));
+		break;
+	case PROP_TITLE:
+		/* Translators: This is the title of the page of apps the distribution features. */
+		g_value_set_string (value, _("Featured"));
+		break;
+	default:
+		G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+		break;
+	}
+}
+
+static void
+gs_featured_page_set_property (GObject      *object,
+                               guint         prop_id,
+                               const GValue *value,
+                               GParamSpec   *pspec)
+{
+	switch ((GsFeaturedPageProperty) prop_id) {
+	case PROP_VADJUSTMENT:
+	case PROP_TITLE:
+		/* Read only. */
+		g_assert_not_reached ();
+		break;
+	default:
+		G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+		break;
+	}
+}
+
+static void
+gs_featured_page_dispose (GObject *object)
+{
+	GsFeaturedPage *self = GS_FEATURED_PAGE (object);
+
+	g_clear_object (&self->plugin_loader);
+	g_clear_object (&self->cancellable);
+
+	G_OBJECT_CLASS (gs_featured_page_parent_class)->dispose (object);
+}
+
+static void
+gs_featured_page_class_init (GsFeaturedPageClass *klass)
+{
+	GObjectClass *object_class = G_OBJECT_CLASS (klass);
+	GsPageClass *page_class = GS_PAGE_CLASS (klass);
+	GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+	object_class->get_property = gs_featured_page_get_property;
+	object_class->set_property = gs_featured_page_set_property;
+	object_class->dispose = gs_featured_page_dispose;
+
+	page_class->switch_to = gs_featured_page_switch_to;
+	page_class->reload = gs_featured_page_reload;
+	page_class->setup = gs_featured_page_setup;
+
+	g_object_class_override_property (object_class, PROP_VADJUSTMENT, "vadjustment");
+	g_object_class_override_property (object_class, PROP_TITLE, "title");
+
+	gtk_widget_class_set_template_from_resource (widget_class, "/org/gnome/Software/gs-featured-page.ui");
+
+	gtk_widget_class_bind_template_child (widget_class, GsFeaturedPage, featured_carousel);
+	gtk_widget_class_bind_template_child (widget_class, GsFeaturedPage, box_featured);
+	gtk_widget_class_bind_template_child (widget_class, GsFeaturedPage, scrolledwindow_featured);
+	gtk_widget_class_bind_template_child (widget_class, GsFeaturedPage, stack_featured);
+	gtk_widget_class_bind_template_callback (widget_class, featured_carousel_app_clicked_cb);
+	gtk_widget_class_bind_template_callback (widget_class, app_activated_cb);
+}
+
+GsFeaturedPage *
+gs_featured_page_new (void)
+{
+	return GS_FEATURED_PAGE (g_object_new (GS_TYPE_FEATURED_PAGE, NULL));
+}
