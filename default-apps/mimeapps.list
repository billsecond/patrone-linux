# Patrone's default apps, installed as /etc/xdg/mimeapps.list: Patrone File
# Manager for folders, Patrone Unpack for archives, .deb packages and
# Flatpak files, and GNOME's Video Player (Showtime, which patrone-desktop
# recommends) for videos. The apps after each Patrone app are fallbacks for
# when it isn't installed (Nautilus, Ubuntu's Files, extracts archives
# itself; GNOME Software installs .deb packages). Each list's first
# installed app is the default.
#
# Videos: every type Video Player opens (its launcher's MimeType), so it
# stays the default when another player is installed. Ubuntu's own list
# puts Totem ("Videos") first for some of them.
#
# Web links and pages: PatroneOS comes with no browser, so the default
# is whichever one is installed: Flathub's, in Patrone Browser Chooser's
# order, then the same browsers as snaps or their makers' own packages
# (browser-chooser/src/browsers.rs has the same IDs). With none installed,
# it's Patrone Browser Chooser, last: it asks which browser to install, then
# opens the link with it.
#
# It's read before Ubuntu's lists in /usr/share/applications, and a user's
# own choices (~/.config/mimeapps.list) still win.
[Default Applications]
application/xhtml+xml=org.chromium.Chromium.desktop;org.mozilla.firefox.desktop;com.brave.Browser.desktop;com.google.Chrome.desktop;com.microsoft.Edge.desktop;com.vivaldi.Vivaldi.desktop;com.opera.Opera.desktop;io.gitlab.librewolf-community.desktop;app.zen_browser.zen.desktop;org.gnome.Epiphany.desktop;chromium_chromium.desktop;chromium.desktop;firefox_firefox.desktop;firefox.desktop;brave_brave.desktop;brave-browser.desktop;google-chrome.desktop;microsoft-edge.desktop;vivaldi-stable.desktop;opera.desktop;librewolf.desktop;org.patrone.BrowserChooser.desktop;
