# Patrone's favorite apps (the dock, and the Activities overview), over
# Ubuntu's: Chromium first, in place of Firefox, then Patrone Terminal. Ubuntu
# sets them again for its own session ([org.gnome.shell:ubuntu]), which beats
# a plain default there, so both are set. Users' own favorites still win.
[org.gnome.shell]
favorite-apps=['chromium_chromium.desktop', 'org.patrone.Terminal.desktop', 'org.gnome.Nautilus.desktop', 'thunderbird_thunderbird.desktop', 'libreoffice-writer.desktop', 'org.gnome.Rhythmbox3.desktop', 'snap-store_snap-store.desktop', 'org.gnome.Yelp.desktop']

[org.gnome.shell:ubuntu]
favorite-apps=['chromium_chromium.desktop', 'org.patrone.Terminal.desktop', 'org.gnome.Nautilus.desktop', 'thunderbird_thunderbird.desktop', 'libreoffice-writer.desktop', 'org.gnome.Rhythmbox3.desktop', 'snap-store_snap-store.desktop', 'org.gnome.Yelp.desktop']
