# Patrone's favorite apps (the dock, and the Activities overview), over
# Ubuntu's: Chromium first, in place of Firefox, then Patrone Terminal and
# Patrone File Manager (in place of Ubuntu's Files), and GNOME Software (in
# place of Canonical's App Center: patrone-software). Ubuntu
# sets them again for its own session ([org.gnome.shell:ubuntu]), which beats
# a plain default there, so both are set. Users' own favorites still win.
[org.gnome.shell]
favorite-apps=['chromium_chromium.desktop', 'org.patrone.Terminal.desktop', 'org.patrone.FileManager.desktop', 'thunderbird_thunderbird.desktop', 'libreoffice-writer.desktop', 'org.gnome.Rhythmbox3.desktop', 'org.gnome.Software.desktop', 'org.gnome.Yelp.desktop']

[org.gnome.shell:ubuntu]
favorite-apps=['chromium_chromium.desktop', 'org.patrone.Terminal.desktop', 'org.patrone.FileManager.desktop', 'thunderbird_thunderbird.desktop', 'libreoffice-writer.desktop', 'org.gnome.Rhythmbox3.desktop', 'org.gnome.Software.desktop', 'org.gnome.Yelp.desktop']
