# Patrone's favorite apps (the dock, and the Activities overview), over
# Ubuntu's: Chromium in place of Firefox, and Patrone Terminal. Ubuntu sets
# them again for its own session ([org.gnome.shell:ubuntu]), which beats a
# plain default there, so both are set. Users' own favorites still win.
[org.gnome.shell]
favorite-apps=['ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop', 'chromium_chromium.desktop', 'thunderbird_thunderbird.desktop', 'org.gnome.Nautilus.desktop', 'org.patrone.Terminal.desktop', 'org.gnome.Rhythmbox3.desktop', 'libreoffice-writer.desktop', 'snap-store_snap-store.desktop', 'org.gnome.Yelp.desktop']

[org.gnome.shell:ubuntu]
favorite-apps=['ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop', 'chromium_chromium.desktop', 'thunderbird_thunderbird.desktop', 'org.gnome.Nautilus.desktop', 'org.patrone.Terminal.desktop', 'org.gnome.Rhythmbox3.desktop', 'libreoffice-writer.desktop', 'snap-store_snap-store.desktop', 'org.gnome.Yelp.desktop']
