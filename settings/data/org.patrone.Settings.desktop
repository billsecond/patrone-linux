[Desktop Entry]
Name=Patrone Settings
Comment=Taskbar, desktop, title bar buttons, theme and mouse pointer
Exec=patrone-settings
Icon=org.patrone.Settings
Terminal=false
Type=Application
Categories=GTK;Settings;DesktopSettings;
Keywords=Taskbar;Desktop;Files;Panel;Corner;Clean;Recycle;Theme;Font;Title;Buttons;Minimize;Maximize;Close;Appearance;Mouse;Pointer;Cursor;Patrone;
StartupNotify=true
Actions=taskbar;desktop;buttons;theme;pointer;

[Desktop Action taskbar]
Name=Taskbar settings
Exec=patrone-settings --page taskbar

[Desktop Action desktop]
Name=Desktop
Exec=patrone-settings --page desktop

[Desktop Action buttons]
Name=Title bar buttons
Exec=patrone-settings --page buttons

[Desktop Action theme]
Name=Theme
Exec=patrone-settings --page theme

[Desktop Action pointer]
Name=Mouse pointer
Exec=patrone-settings --page pointer
