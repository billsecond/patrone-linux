<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wallpapers SYSTEM "gnome-wp-list.dtd">
<!-- Patrone's wallpapers in Settings > Appearance. A wallpaper with a
     filename-dark is a pair: GNOME shows filename in the light style and
     filename-dark in the dark one. See branding/README.md. -->
<wallpapers>
