# The login screen's settings, from patrone-branding. GDM merges this folder
# into its settings each time it starts, after Ubuntu's 90-debian-settings.
[org/gnome/login-screen]
# Shown at the file's own size, so it has its own small file
logo='/usr/share/pixmaps/patrone-logo-login.png'

# Blue focus rings and buttons in place of Ubuntu's orange, and Patrone's
# typeface, Patrone Sans, in place of Ubuntu's
[org/gnome/desktop/interface]
accent-color='blue'
font-name='Patrone Sans 11'
