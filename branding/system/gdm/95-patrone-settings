# The login screen's settings, from patrone-branding. GDM merges this folder
# into its settings each time it starts, after Ubuntu's 90-debian-settings.
[org/gnome/login-screen]
logo='/usr/share/pixmaps/patrone-logo-text-dark.png'

# Blue focus rings and buttons in place of Ubuntu's orange, and a neutral
# typeface in place of Ubuntu Sans
[org/gnome/desktop/interface]
accent-color='blue'
font-name='Noto Sans 11'
