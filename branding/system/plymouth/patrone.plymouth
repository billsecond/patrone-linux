[Plymouth Theme]
Name=Patrone
Description=The Patrone logo over a spinning ring on Patrone's near-black
ModuleName=two-step

[two-step]
# watermark.png is the Patrone logo; throbber-* and animation-* are Patrone's
# spinner, drawn by branding/tools/make_spinner.py; the password prompt's
# images are Ubuntu's spinner theme's, its field recolored blue by
# branding/tools/make_prompt_images.py.
ImageDir=/usr/share/plymouth/themes/patrone
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
HorizontalAlignment=.5
VerticalAlignment=.72
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.72
# The update modes' title and subtitle go under the wordmark and over the
# progress bar, which is lower than the spinner to make room: on screens
# from 800x600 to 2560x1440 nothing touches (branding/README.md, "Boot
# splash layout"). Only the update modes have titles or the bar.
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.75
TitleFont=Sans 20
ProgressBarVerticalAlignment=.83
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x030303
BackgroundEndColor=0x030303
ProgressBarBackgroundColor=0x1c2230
ProgressBarForegroundColor=0x288bfa
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
