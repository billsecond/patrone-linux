# Patrone's defaults for GNOME, over Ubuntu's (10_ubuntu-settings). Users'
# own settings still win. Ubuntu sets some keys again for its own session
# ([schema:ubuntu]; its session has XDG_CURRENT_DESKTOP=ubuntu:GNOME), and
# those beat a plain default there, so Patrone sets them in both.

# Ubuntu's dock is off: Patrone will have its own panel.
[org.gnome.shell]
disabled-extensions=['ubuntu-dock@ubuntu.com']

# Patrone blue in place of Ubuntu's orange: the accent for GNOME Shell and
# GTK 4 apps, and Yaru's blue theme and icons for GTK 3 apps (Chromium's
# dialogs among them), which don't follow the accent. Patrone's cursors
# (tools/make_cursors.py) in place of Yaru's.
[org.gnome.desktop.interface]
accent-color='blue'
gtk-theme='Yaru-blue'
icon-theme='Yaru-blue'
cursor-theme='Patrone'
font-name='PatroneOS Sans 11'
document-font-name='PatroneOS Document 11'
monospace-font-name='PatroneOS Mono 11'
# 12-hour time with AM or PM, on the taskbar and the lock screen, whatever the
# language, in place of the 24-hour time GNOME starts with
clock-format='12h'
# Plain gray edges on text. Ubuntu sets 'rgba' for its session and the login
# screen, which fringes letters with color; fontconfig's side of this is in
# 05-patrone-fonts.conf, for the apps that go by that instead
font-antialiasing='grayscale'

[org.gnome.desktop.interface:ubuntu]
font-antialiasing='grayscale'
gtk-theme='Yaru-blue'
icon-theme='Yaru-blue'
cursor-theme='Patrone'
font-name='PatroneOS Sans 11'
document-font-name='PatroneOS Document 11'
monospace-font-name='PatroneOS Mono 11'

# Ubuntu sets the login screen's cursors too ([schema:GNOME-Greeter])
[org.gnome.desktop.interface:GNOME-Greeter]
cursor-theme='Patrone'
font-antialiasing='grayscale'

# PatroneOS's fonts (fonts-patroneos): PatroneOS Sans for the desktop, apps
# and window titles (semibold), PatroneOS Document for documents and
# PatroneOS Mono for monospace text (above). Apps and pages that ask for
# sans-serif, serif or monospace get them through 05-patrone-fonts.conf,
# with Noto behind them for scripts they don't cover. Patrone Settings'
# Theme page can switch the desktop to Noto Sans instead.
[org.gnome.desktop.wm.preferences]
titlebar-font='PatroneOS Sans SemiBold 11'

[org.gnome.desktop.wm.preferences:ubuntu]
titlebar-font='PatroneOS Sans SemiBold 11'

# Wallpaper 02, Neon Horizon, light in the light style and dark in the dark one
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-02-light.png'
picture-uri-dark='file:///usr/share/backgrounds/patrone/patrone-back-02-dark.png'
picture-options='zoom'
primary-color='#030303'

[org.gnome.desktop.background:ubuntu]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-02-light.png'
picture-uri-dark='file:///usr/share/backgrounds/patrone/patrone-back-02-dark.png'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-02-dark.png'
picture-options='zoom'
primary-color='#030303'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-02-dark.png'
