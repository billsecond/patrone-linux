# Patrone's defaults for GNOME, over Ubuntu's (10_ubuntu-settings). Users'
# own settings still win. Ubuntu sets some keys again for its own session
# ([schema:ubuntu]; its session has XDG_CURRENT_DESKTOP=ubuntu:GNOME), and
# those beat a plain default there, so Patrone sets them in both.

# Ubuntu's dock is off: Patrone will have its own panel.
[org.gnome.shell]
disabled-extensions=['ubuntu-dock@ubuntu.com']

# Patrone blue in place of Ubuntu's orange: the accent for GNOME Shell and
# GTK 4 apps, and Yaru's blue theme and icons for GTK 3 apps (Chromium's
# dialogs among them), which don't follow the accent
[org.gnome.desktop.interface]
accent-color='blue'
gtk-theme='Yaru-blue'
icon-theme='Yaru-blue'
font-name='Inter 11'
document-font-name='Inter 11'

[org.gnome.desktop.interface:ubuntu]
gtk-theme='Yaru-blue'
icon-theme='Yaru-blue'
font-name='Inter 11'
document-font-name='Inter 11'

# Inter, Patrone's typeface (close to Segoe UI, and the font of Patrone's own
# apps), for the desktop, apps and window titles. Web pages and apps that ask
# for sans-serif or Segoe UI get it through 05-patrone-fonts.conf. Monospace
# stays Ubuntu Sans Mono.
[org.gnome.desktop.wm.preferences]
titlebar-font='Inter Semi-Bold 11'

[org.gnome.desktop.wm.preferences:ubuntu]
titlebar-font='Inter Semi-Bold 11'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-01-8k.png'
picture-uri-dark='file:///usr/share/backgrounds/patrone/patrone-back-01-8k.png'
picture-options='zoom'
primary-color='#030303'

[org.gnome.desktop.background:ubuntu]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-01-8k.png'
picture-uri-dark='file:///usr/share/backgrounds/patrone/patrone-back-01-8k.png'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-01-8k.png'
picture-options='zoom'
primary-color='#030303'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri='file:///usr/share/backgrounds/patrone/patrone-back-01-8k.png'
