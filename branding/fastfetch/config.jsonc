// Patrone Linux's fastfetch setup, to be installed as
// /etc/xdg/fastfetch/config.jsonc, with logo.txt as
// /usr/share/patrone/fastfetch/logo.txt. Colors are the Patrone blues from
// branding/README.md: $1 is Patrone Blue #288BFA, $2 Highlight #4DA0FC,
// $3 white.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/patrone/fastfetch/logo.txt",
        "color": {
            "1": "38;2;40;139;250",
            "2": "38;2;77;160;252",
            "3": "97"
        },
        "padding": {
            "top": 1,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;77;160;252",
            "title": "38;2;40;139;250"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
