// PatroneOS's fastfetch setup, to be installed as
// /etc/xdg/fastfetch/config.jsonc, with logo.txt as
// /usr/share/patrone/fastfetch/logo.txt. The logo has its colors written in
// as 24-bit color codes (every cell its own, by tools/make_terminal_logo.py),
// which a "file" logo passes through while still measuring the logo's width
// itself; a "file-raw" one asks the terminal where the cursor is instead.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/patrone/fastfetch/logo.txt",
        "padding": {
            "top": 1,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;77;160;252",
            "title": "38;2;40;139;250"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
