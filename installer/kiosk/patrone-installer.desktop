[Desktop Entry]
# The "Install PatroneOS" session (README.md, "Installing with nothing
# else"): Patrone's installer full screen, in GNOME Kiosk, with no desktop.
Name=PatroneOS Installer
Comment=Install PatroneOS
Exec=gnome-session --session patrone-installer
TryExec=gnome-session
Type=Application
DesktopNames=GNOME-Kiosk;
X-GDM-SessionRegisters=false
