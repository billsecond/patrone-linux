#!/bin/sh
# Puts back the Ubuntu program that preinst moved aside.
set -e

remove_diversion() {
    dpkg-divert --package patrone-shell-config --remove --rename \
        --divert /usr/lib/command-not-found.ubuntu /usr/lib/command-not-found
}

case "$1" in
    remove | abort-install | disappear)
        remove_diversion
        ;;
    abort-upgrade)
        # An upgrade from before 0.3.0 that failed after preinst, and back
        # to a version without Patrone's program
        if dpkg --compare-versions "$2" lt 0.3.0; then
            remove_diversion
        fi
        ;;
esac

#DEBHELPER#
