#!/bin/sh
# Takes out the default login shell that postinst added.
set -e

marker="# patrone-shell-config: new users get zsh"

unset_default() {
    file=$1
    [ -f "$file" ] || return 0
    # The marker and the setting after it
    sed -i "/^$marker\$/,+1d" "$file"
}

case "$1" in
    remove | purge)
        unset_default /etc/adduser.conf
        unset_default /etc/default/useradd
        ;;
esac

#DEBHELPER#
