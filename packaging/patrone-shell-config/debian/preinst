#!/bin/sh
# bash and zsh run /usr/lib/command-not-found when a command isn't found, and
# it's the one place both reach for every account, since accounts have their
# own copies of the shells' setup files. So Patrone's takes that place, and
# Ubuntu's, with its updates, stays beside it as command-not-found.ubuntu
# (postrm puts it back). /etc/bash.bashrc and /etc/zsh_command_not_found stay
# as they are: they're configuration files, which dpkg would ask about.
set -e

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    dpkg-divert --package patrone-shell-config --add --rename \
        --divert /usr/lib/command-not-found.ubuntu /usr/lib/command-not-found
fi

#DEBHELPER#
