#!/bin/sh
# Root's account comes with the system, before this package, so /etc/skel's
# files never reach it, and a root shell from `sudo su`, `sudo -i` or `su -`
# showed Ubuntu's plain prompt. Give root Patrone's prompt too, which is red
# for root: .bash_aliases, which root's Ubuntu .bashrc reads, and .zshrc for
# `sudo -s` from zsh. Files root already has are left alone, and only the
# first install, or the upgrade that brings this, adds them, so one taken
# away later stays away.
set -e

if [ "$1" = configure ] && { [ -z "$2" ] || dpkg --compare-versions "$2" lt 0.2.1; }; then
    for file in .bash_aliases .zshrc; do
        if [ -d /root ] && [ ! -e "/root/$file" ] && [ ! -L "/root/$file" ]; then
            cp "/etc/skel/$file" "/root/$file"
        fi
    done
fi

#DEBHELPER#
