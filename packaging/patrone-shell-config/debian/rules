#!/usr/bin/make -f

pkg = debian/patrone-shell-config

%:
	dh $@

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	bash tests/windows-commands.sh
	bash tests/prompt.sh
endif

override_dh_auto_install:
	install -Dm644 bashrc $(pkg)/usr/share/patrone/bashrc
	install -Dm644 windows-commands.tsv $(pkg)/usr/share/patrone/windows-commands.tsv
	install -Dm755 command-not-found $(pkg)/usr/lib/command-not-found
	install -Dm644 bash_aliases $(pkg)/etc/skel/.bash_aliases
	install -Dm644 zshrc $(pkg)/etc/skel/.zshrc
	install -Dm644 zprofile $(pkg)/etc/skel/.zprofile
