#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

pkg = debian/patrone-remote-desktop
libexec = $(pkg)/usr/libexec/patrone-remote-desktop

%:
	dh $@

override_dh_auto_install:
	install -Dm644 -t $(pkg)/usr/lib/$(DEB_HOST_MULTIARCH)/freerdp3/proxy \
	    proxy-patrone-login-plugin.so proxy-patrone-vmconnect-plugin.so
	install -Dm755 patrone-remote-desktop-auth $(libexec)/auth
	install -Dm755 patrone-remote-desktop-greeter $(libexec)/greeter
	install -Dm755 libexec/vmconnect-certificate $(libexec)/vmconnect-certificate
	install -Dm755 libexec/prepare-session $(libexec)/prepare-session
	install -Dm755 libexec/no-lock $(libexec)/no-lock
	install -Dm755 libexec/console $(libexec)/console
	install -Dm755 libexec/session $(libexec)/session
	install -Dm755 libexec/settings $(libexec)/settings
	install -Dm644 data/org.patrone.remote-desktop.policy \
	    $(pkg)/usr/share/polkit-1/actions/org.patrone.remote-desktop.policy
	install -Dm644 data/gnome.desktop $(pkg)/usr/share/wayland-sessions/gnome.desktop
	install -Dm644 -t $(pkg)/usr/share/gnome-shell/extensions/patrone-login@patrone-linux \
	    login-screen/patrone-login@patrone-linux/extension.js \
	    login-screen/patrone-login@patrone-linux/metadata.json
	install -Dm644 data/96-patrone-remote-desktop $(pkg)/usr/share/gdm/dconf/96-patrone-remote-desktop
	install -Dm644 data/patrone-desktops.rules \
	    $(pkg)/usr/share/polkit-1/rules.d/45-patrone-desktops.rules
	install -Dm755 sbin/patrone-remote-desktop $(pkg)/usr/sbin/patrone-remote-desktop
	install -Dm644 -t $(pkg)/etc/patrone-remote-desktop data/proxy.ini data/vmconnect.ini
	install -Dm644 data/patrone-remote-desktop.pam $(pkg)/etc/pam.d/patrone-remote-desktop
	install -Dm644 data/patrone-remote-desktop-vmconnect.pam \
	    $(pkg)/etc/pam.d/patrone-remote-desktop-vmconnect
	install -Dm644 data/patrone-remote-desktop.pam-config \
	    $(pkg)/usr/share/pam-configs/patrone-remote-desktop
	install -Dm644 data/patrone-remote-desktop-no-lock.desktop \
	    $(pkg)/etc/xdg/autostart/patrone-remote-desktop-no-lock.desktop
	install -Dm644 -t $(pkg)/usr/lib/systemd/system data/patrone-remote-desktop.service \
	    data/patrone-remote-desktop-auth.socket data/patrone-remote-desktop-auth@.service \
	    data/patrone-remote-desktop-console.socket data/patrone-remote-desktop-console@.service \
	    data/patrone-remote-desktop-vmconnect.service \
	    data/patrone-remote-desktop-greeter.socket data/patrone-remote-desktop-greeter@.service \
	    data/patrone-remote-desktop-vmconnect-auth.socket \
	    data/patrone-remote-desktop-vmconnect-auth@.service
	install -Dm644 data/gnome-headless-session-static-user.conf \
	    $(pkg)/usr/lib/systemd/system/gnome-headless-session@.service.d/patrone-static-user.conf
	install -Dm644 README.md $(pkg)/usr/share/doc/patrone-remote-desktop/README.md

# The machine's own screen always works, and so does Hyper-V's enhanced
# session (its service starts only on Hyper-V). Remote Desktop is off until
# an administrator runs patrone-remote-desktop enable.
override_dh_installsystemd:
	dh_installsystemd patrone-remote-desktop-console.socket
	dh_installsystemd patrone-remote-desktop-vmconnect.service
	dh_installsystemd --no-enable --no-start patrone-remote-desktop.service \
	    patrone-remote-desktop-auth.socket
