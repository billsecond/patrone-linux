#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # Accounts in this group may sign in over Remote Desktop.
    if ! getent group remote-desktop > /dev/null; then
        addgroup --system --quiet remote-desktop
    fi
    # The proxy's own account; it can ask the sign-in helper, nothing more.
    if ! getent passwd patrone-rdp > /dev/null; then
        adduser --system --quiet --group --no-create-home \
            --home /var/lib/patrone-remote-desktop/proxy patrone-rdp
    fi
    # The PAM hook that keeps the password hash NLA checks current
    pam-auth-update --package
fi

#DEBHELPER#

# systemd reads the changed unit files, and the drop-in for GDM's headless
# session unit. (Don't name debhelper's placeholder in a comment: debhelper
# replaces it wherever it appears.)
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload > /dev/null || true
fi

# On an upgrade, debhelper has stopped Remote Desktop (and was told not to
# start it, since it's off until enabled), so start it again, with the new
# plugin, if an administrator turned it on.
if [ "$1" = configure ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
    for unit in patrone-remote-desktop-auth.socket patrone-remote-desktop.service; do
        if systemctl is-enabled --quiet "$unit"; then
            deb-systemd-invoke restart "$unit" || true
        fi
    done
fi
