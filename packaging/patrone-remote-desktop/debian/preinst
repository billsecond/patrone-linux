#!/bin/sh
# Patrone Desktop is the login screen's only session. Ubuntu's own session
# leaves it: on Patrone the screen joins each account's one desktop, and a
# plain GNOME session started there would end that desktop. This package's
# gnome.desktop is Patrone Desktop (GDM's fallback name); a gnome.desktop
# from any other package is moved aside too. postrm puts both back.
set -e

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    for session in ubuntu gnome; do
        dpkg-divert --package patrone-remote-desktop --add --rename \
            --divert "/usr/share/wayland-sessions/$session.desktop.patrone-hidden" \
            "/usr/share/wayland-sessions/$session.desktop"
    done
fi

#DEBHELPER#
