#!/bin/sh
# Ubuntu's own session leaves the login screen. On Patrone the screen joins
# each account's one desktop (the Patrone Desktop session), and a plain GNOME
# session started there would end that desktop. patrone-gnome.desktop takes
# over the other job ubuntu.desktop had: the session background desktops
# run. postrm puts ubuntu.desktop back.
set -e

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    dpkg-divert --package patrone-remote-desktop --add --rename \
        --divert /usr/share/wayland-sessions/ubuntu.desktop.patrone-hidden \
        /usr/share/wayland-sessions/ubuntu.desktop
fi

#DEBHELPER#
