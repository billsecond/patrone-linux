#!/usr/bin/make -f
# The source tree arrives with its crates vendored (packaging/build.sh), so
# cargo never touches the network.

export CARGO_HOME = $(CURDIR)/debian/cargo-home
pkg = debian/patrone-terminal

%:
	dh $@

override_dh_auto_build:
	cargo build --release --frozen

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --frozen
endif

override_dh_auto_install:
	install -Dm755 target/release/patrone-terminal $(pkg)/usr/bin/patrone-terminal
	install -Dm644 data/org.patrone.Terminal.desktop $(pkg)/usr/share/applications/org.patrone.Terminal.desktop
	install -Dm644 data/org.patrone.Terminal.svg $(pkg)/usr/share/icons/hicolor/scalable/apps/org.patrone.Terminal.svg
	# Opens a terminal at every login
	install -Dm644 data/autostart/org.patrone.Terminal.desktop $(pkg)/etc/xdg/autostart/org.patrone.Terminal.desktop
	install -Dm755 data/autostart/patrone-terminal-autostart \
	    $(pkg)/usr/libexec/patrone-terminal/patrone-terminal-autostart
	# The terminal xdg-terminal-exec picks in a Patrone Desktop session
	install -d $(pkg)/usr/share/xdg-terminal-exec
	echo org.patrone.Terminal.desktop > $(pkg)/usr/share/xdg-terminal-exec/patrone-xdg-terminals.list

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean deletes *.orig files, but every vendored crate has a
# Cargo.toml.orig that cargo checksums.
override_dh_clean:
	dh_clean -XCargo.toml.orig
