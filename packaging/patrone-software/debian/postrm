#!/bin/sh
# Puts back GNOME's picks and GNOME Software's own launcher, which preinst
# moved aside.
set -e

featured=/usr/share/swcatalog/xml/org.gnome.Software.Featured.xml
launcher=/usr/share/applications/org.gnome.Software.desktop

case "$1" in
    remove | abort-install | disappear)
        dpkg-divert --package patrone-software --remove --rename --divert "$featured.gnome" "$featured"
        rm -f "$launcher" "$launcher.new"
        dpkg-divert --package patrone-software --remove --rename --divert "$launcher.gnome" "$launcher"
        # Patrone's app index, unless apps installed from it still need it
        # for updates. Flathub stays: other apps may come from it.
        if command -v flatpak > /dev/null 2>&1; then
            flatpak remote-delete --system patrone-app-index > /dev/null 2>&1 || true
        fi
        ;;
esac

#DEBHELPER#
