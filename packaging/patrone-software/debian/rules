#!/usr/bin/make -f

pkg = debian/patrone-software

%:
	dh $@

override_dh_auto_install:
	install -Dm644 org.patrone.Software.Featured.xml \
	    $(pkg)/usr/share/swcatalog/xml/org.patrone.Software.Featured.xml
	install -Dm755 make-software-launcher \
	    $(pkg)/usr/libexec/patrone-software/make-software-launcher
