#!/bin/sh
set -e

#DEBHELPER#

# On a running system (not while an image is built): the udev rule for
# file copy counts from the next device event (debhelper has started the
# unit itself), the KVP and VSS daemons take their drop-ins when they
# restart, and chrony takes the host's clock. None of it happens off
# Hyper-V.
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    udevadm control --reload > /dev/null 2>&1 || true
    if [ "$(systemd-detect-virt --vm 2> /dev/null)" = microsoft ]; then
        deb-systemd-invoke try-restart hv-kvp-daemon.service hv-vss-daemon.service || true
        deb-systemd-invoke try-restart chrony.service || true
    fi
fi
