#!/usr/bin/make -f

pkg = debian/patrone-guest-tools
units = $(pkg)/usr/lib/systemd/system
user_units = $(pkg)/usr/lib/systemd/user
libexec = $(pkg)/usr/libexec/patrone-guest-tools

%:
	dh $@

override_dh_auto_install:
	# Hyper-V
	install -Dm755 hyperv/hv-tool $(libexec)/hv-tool
	install -Dm755 hyperv/vss-hide-fuse $(libexec)/vss-hide-fuse
	for unit in hv-kvp-daemon hv-vss-daemon hv-fcopy-daemon; do \
	    install -Dm644 hyperv/$$unit.conf \
	        $(units)/$$unit.service.d/patrone-guest-tools.conf || exit 1; \
	done
	install -Dm644 hyperv/patrone-hv-fcopy.service $(units)/patrone-hv-fcopy.service
	install -Dm755 hyperv/hv-fcopy-bind $(libexec)/hv-fcopy-bind
	install -Dm644 hyperv/61-patrone-hv-fcopy.rules \
	    $(pkg)/usr/lib/udev/rules.d/61-patrone-hv-fcopy.rules
	install -Dm755 hyperv/chrony-hyperv-clock $(libexec)/chrony-hyperv-clock
	install -Dm644 hyperv/chrony-hyperv-clock.conf \
	    $(units)/chrony.service.d/patrone-hyperv-clock.conf
	install -Dm644 hyperv/patrone-hyperv-clock.conf \
	    $(pkg)/etc/chrony/conf.d/patrone-hyperv-clock.conf
	# VirtualBox
	install -Dm755 virtualbox/vbox-users $(libexec)/vbox-users
	install -Dm644 virtualbox/patrone-vbox-users.service $(units)/patrone-vbox-users.service
	install -Dm644 virtualbox/patrone-vbox-users.path $(units)/patrone-vbox-users.path
	install -Dm644 virtualbox/patrone-vboxclient-wayland.service \
	    $(user_units)/patrone-vboxclient-wayland.service
	install -Dm644 virtualbox/patrone-vboxclient-vmsvga.service \
	    $(user_units)/patrone-vboxclient-vmsvga.service
	install -Dm644 README.md $(pkg)/usr/share/doc/patrone-guest-tools/README.md

# The vboxdrmipc group (debian/patrone-guest-tools.sysusers); compat 13's
# sequence doesn't run dh_installsysusers by itself. Its postinst snippet
# comes before the units are started.
execute_after_dh_install:
	dh_installsysusers
