#!/usr/bin/make -f
# The source tree arrives with its crates vendored (packaging/build.sh), so
# cargo never touches the network.

export CARGO_HOME = $(CURDIR)/debian/cargo-home
pkg = debian/patrone-hyperv-setup

%:
	dh $@

override_dh_auto_build:
	cargo build --release --frozen

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --frozen
endif

override_dh_auto_install:
	install -Dm755 target/release/patrone-hyperv-setup $(pkg)/usr/bin/patrone-hyperv-setup
	install -Dm755 libexec/apply $(pkg)/usr/libexec/patrone-hyperv-setup/apply
	install -Dm644 data/org.patrone.hyperv-setup.policy \
	    $(pkg)/usr/share/polkit-1/actions/org.patrone.hyperv-setup.policy
	install -Dm644 data/org.patrone.HyperVSetup.desktop \
	    $(pkg)/usr/share/applications/org.patrone.HyperVSetup.desktop
	install -Dm644 data/org.patrone.HyperVSetup.svg \
	    $(pkg)/usr/share/icons/hicolor/scalable/apps/org.patrone.HyperVSetup.svg
	# At login (dh_installsystemduser enables it for every account)
	install -Dm644 data/patrone-hyperv-setup.service \
	    $(pkg)/usr/lib/systemd/user/patrone-hyperv-setup.service
	# When Hyper-V opens an enhanced session
	install -Dm644 data/patrone-hyperv-setup-seen.service \
	    $(pkg)/usr/lib/systemd/system/patrone-hyperv-setup-seen.service
	install -Dm644 data/62-patrone-hyperv-setup.rules \
	    $(pkg)/usr/lib/udev/rules.d/62-patrone-hyperv-setup.rules
	install -Dm644 README.md $(pkg)/usr/share/doc/patrone-hyperv-setup/README.md

# patrone-hyperv-setup-seen.service runs only when Hyper-V opens an enhanced
# session (the udev rule). Started as the package installs, as debhelper
# would, it would say Hyper-V had.
override_dh_installsystemd:

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean deletes *.orig files, but every vendored crate has a
# Cargo.toml.orig that cargo checksums.
override_dh_clean:
	dh_clean -XCargo.toml.orig
