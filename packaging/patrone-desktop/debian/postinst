#!/bin/sh
set -e

. /usr/share/debconf/confmodule

pools=/etc/chrony/sources.d/ubuntu-ntp-pools.sources
esm_hook=/etc/apt/apt.conf.d/20apt-esm-hook.conf

if [ "$1" = configure ]; then
    # Ubuntu's chrony asks whether to keep its ntp.ubuntu.com pools in
    # sources.d. Answer no, and drop the file the way chrony's postinst does
    # with that answer; the servers Patrone uses are in patrone-nts.sources.
    if dpkg-query -W -f='${Status}' chrony 2> /dev/null | grep -q ' installed$'; then
        db_set chrony/configure_ubuntu_pools_in_sourcesd false || true
        if command -v ucf > /dev/null; then
            ucf --debconf-ok --purge "$pools"
        fi
        if command -v ucfr > /dev/null; then
            ucfr --purge chrony "$pools"
        fi
        rm -f "$pools"
    fi

    # Before 0.2.0, Ubuntu Pro's apt hook was moved aside. Ubuntu Pro's
    # client is gone now (Conflicts), leaving its configuration files behind,
    # this one among them: it goes too, rather than back into apt's way.
    if [ "$(dpkg-divert --listpackage "$esm_hook")" = patrone-desktop ]; then
        dpkg-divert --package patrone-desktop --remove \
            --divert /usr/share/patrone-desktop/20apt-esm-hook.conf.ubuntu "$esm_hook"
        rm -f /usr/share/patrone-desktop/20apt-esm-hook.conf.ubuntu
        rmdir --ignore-fail-on-non-empty /usr/share/patrone-desktop 2> /dev/null || true
    fi

    # Pick up the new time servers and the network check's server
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl try-restart chrony.service || true
        systemctl try-reload-or-restart NetworkManager.service || true
    fi
fi

# Patrone's session mode, from Ubuntu's (preinst moved it aside), and again
# whenever gnome-shell-common brings a new one (the modes folder's trigger).
# It counts from the next sign-in.
if [ "$1" = configure ] || [ "$1" = triggered ]; then
    /usr/libexec/patrone-desktop/make-session-mode
fi

#DEBHELPER#
