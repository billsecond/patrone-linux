#!/bin/sh
set -e

pools=/etc/chrony/sources.d/ubuntu-ntp-pools.sources
packaged_pools=/usr/share/chrony/ubuntu-ntp-pools.sources

case "$1" in
    remove | purge)
        # Ubuntu's time servers come back, the way chrony's postinst puts
        # them in place when its question is answered yes.
        if [ "$1" = remove ] && [ -e "$packaged_pools" ] && [ ! -e "$pools" ]; then
            . /usr/share/debconf/confmodule
            db_set chrony/configure_ubuntu_pools_in_sourcesd true || true
            if command -v ucf > /dev/null; then
                ucf --debconf-ok --three-way "$packaged_pools" "$pools"
            else
                cp "$packaged_pools" "$pools"
            fi
            if command -v ucfr > /dev/null; then
                ucfr chrony "$pools"
            fi
        fi

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemctl try-restart chrony.service || true
            systemctl try-reload-or-restart NetworkManager.service || true
        fi
        ;;
esac

# Ubuntu's session mode back in its place (and Ubuntu Pro's apt hook, which
# versions before 0.2.0 moved aside, if postinst never got to put it back)
mode=/usr/share/gnome-shell/modes/ubuntu.json
aside=/usr/share/patrone-desktop/ubuntu.json.ubuntu
old_aside=$mode.ubuntu
case "$1" in
    remove | abort-install | disappear)
        rm -f "$mode" "$mode.new"
        dpkg-divert --package patrone-desktop --remove --rename --divert "$aside" "$mode"
        dpkg-divert --package patrone-desktop --remove --rename \
            --divert /usr/share/patrone-desktop/20apt-esm-hook.conf.ubuntu /etc/apt/apt.conf.d/20apt-esm-hook.conf
        rmdir --ignore-fail-on-non-empty /usr/share/patrone-desktop 2> /dev/null || true
        ;;
    abort-upgrade)
        # An upgrade from before 0.2.6 that failed after preinst moved
        # Ubuntu's mode to its new place: back where the old version keeps it,
        # and the old version's mode made again from it
        if dpkg --compare-versions "$2" lt 0.2.6 &&
            [ "$(dpkg-divert --truename "$mode")" = "$aside" ]; then
            rm -f "$mode"
            dpkg-divert --package patrone-desktop --remove --rename --divert "$aside" "$mode"
            dpkg-divert --package patrone-desktop --add --rename --divert "$old_aside" "$mode"
            /usr/libexec/patrone-desktop/make-session-mode || true
        fi
        ;;
esac

#DEBHELPER#
