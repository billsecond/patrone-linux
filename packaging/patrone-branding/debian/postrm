#!/bin/sh
# Puts back the Ubuntu files that preinst moved aside.
set -e

diverted="
/usr/lib/os-release
/etc/issue
/etc/issue.net
/etc/lsb-release
/etc/legal
/etc/update-motd.d/00-header
/etc/update-motd.d/10-help-text
/etc/update-motd.d/50-motd-news
/etc/update-motd.d/90-updates-available
/etc/update-motd.d/91-contract-ua-esm-status
/usr/share/applications/gnome-ubuntu-panel.desktop
/usr/share/icons/Yaru/scalable/places/start-here-symbolic.svg
/usr/share/icons/Yaru/scalable/places/distributor-logo-symbolic.svg
"
for size in 16 22 24 32 48 256; do
    diverted="$diverted
/usr/share/icons/Yaru/${size}x$size/places/start-here.png
/usr/share/icons/Yaru/${size}x$size@2x/places/start-here.png"
done

case "$1" in
    remove | abort-install | disappear)
        for file in $diverted; do
            dpkg-divert --package patrone-branding --remove --rename --divert "$file.ubuntu" "$file"
        done
        for file in /etc/grub.d/10_linux /etc/grub.d/10_linux_zfs; do
            rm -f "$file"
            dpkg-divert --package patrone-branding --remove --rename \
                --divert "/usr/share/patrone-branding/grub/${file##*/}" "$file"
        done
        rmdir --ignore-fail-on-non-empty /usr/share/patrone-branding/grub 2>/dev/null || true
        if command -v update-initramfs > /dev/null; then
            update-initramfs -u
        fi
        if command -v update-grub > /dev/null; then
            update-grub
        fi
        ;;
    abort-upgrade)
        # An upgrade from a version before 0.1.22 that failed after preinst
        # moved GRUB's scripts aside and before postinst put Patrone's in
        # their place: GRUB's come back, or the next update-grub would leave
        # the boot menu without the system
        for file in /etc/grub.d/10_linux /etc/grub.d/10_linux_zfs; do
            [ -e "$file" ] || dpkg-divert --package patrone-branding --remove --rename \
                --divert "/usr/share/patrone-branding/grub/${file##*/}" "$file"
        done
        ;;
esac

#DEBHELPER#
