#!/usr/bin/make -f

pkg = debian/patrone-branding
theme = $(pkg)/usr/share/plymouth/themes/patrone
spinner = /usr/share/plymouth/themes/spinner

yaru = /usr/share/gnome-shell/theme/Yaru/gnome-shell-theme.gresource

%:
	dh $@

# The login screen's theme: Yaru's with Patrone's stylesheet added
override_dh_auto_build:
	sh tools/make_gdm_theme.sh $(yaru) system/gdm/patrone-gdm.css build/gnome-shell-theme.gresource
	# Patrone's cursor themes (Patrone Blue, Black and White), drawn by
	# tools/make_cursors.py, a folder each in build/cursors
	python3 tools/make_cursors.py build/cursors

override_dh_auto_clean:
	rm -rf build

override_dh_auto_install:
	install -Dm644 system/os-release $(pkg)/usr/lib/os-release
	install -Dm644 system/issue $(pkg)/etc/issue
	install -Dm644 system/issue.net $(pkg)/etc/issue.net
	# lsb-release (installers' and boot menus' other-system detection read
	# it; the codename stays Ubuntu's, which tools need) and legal (shown
	# at a text console's login): links, not configuration files, so
	# installing them asks nothing
	install -Dm644 system/lsb-release $(pkg)/usr/share/patrone-branding/lsb-release
	ln -s ../usr/share/patrone-branding/lsb-release $(pkg)/etc/lsb-release
	install -Dm644 system/legal $(pkg)/usr/share/patrone-branding/legal
	ln -s ../usr/share/patrone-branding/legal $(pkg)/etc/legal
	install -Dm755 system/motd/00-header $(pkg)/etc/update-motd.d/00-header
	# The boot menu's scripts, which postinst copies into /etc/grub.d
	install -Dm755 system/grub/grub-script $(pkg)/usr/lib/patrone-branding/grub-script
	install -Dm644 system/plymouth/patrone.plymouth $(theme)/patrone.plymouth
	install -Dm644 logos/patrone-splash.png $(theme)/watermark.png
	# Patrone's spinner, a single ring (tools/make_spinner.py)
	install -m644 -t $(theme) system/plymouth/spinner/throbber-*.png \
	    system/plymouth/spinner/animation-*.png
	# The password prompt's field, Plymouth's recolored from orange to
	# Patrone Blue (tools/make_prompt_images.py)
	install -m644 -t $(theme) system/plymouth/prompt/lock.png \
	    system/plymouth/prompt/entry.png
	# Its other images, copied from Plymouth's spinner theme. Copies, not
	# links: the initramfs hook copies the theme folder with cp -a, so links
	# to the spinner folder would dangle at boot.
	for image in $(spinner)/*.png; do \
	    name=$$(basename $$image); \
	    case $$name in watermark.png | bgrt-fallback.png | throbber-* | animation-* | lock.png | entry.png) ;; \
	    *) install -m644 $$image $(theme)/$$name ;; esac; \
	done
	install -Dm644 system/plymouth/patrone-text.plymouth \
	    $(pkg)/usr/share/plymouth/themes/patrone-text/patrone-text.plymouth
	install -Dm644 system/gdm/95-patrone-settings $(pkg)/usr/share/gdm/dconf/95-patrone-settings
	install -Dm644 system/settings/gnome-ubuntu-panel.desktop \
	    $(pkg)/usr/share/applications/gnome-ubuntu-panel.desktop
	install -Dm644 build/gnome-shell-theme.gresource \
	    $(pkg)/usr/share/gnome-shell/theme/Patrone/gnome-shell-theme.gresource
	# The cursor themes: Patrone (Patrone Blue), made the default by the
	# override below, 95-patrone-settings (the login screen) and postinst
	# (x-cursor-theme, for everything else), and Patrone-Black and
	# Patrone-White, which Settings' Mouse pointer choice offers
	install -d $(pkg)/usr/share/icons
	cp -a build/cursors/. $(pkg)/usr/share/icons/
	install -Dm644 system/schemas/90_patrone.gschema.override \
	    $(pkg)/usr/share/glib-2.0/schemas/90_patrone.gschema.override
	# PatroneOS's fonts for sans-serif, serif and monospace, and as stand-ins:
	# for the system (conf.d) and for snaps such as Chromium, which read
	# /etc/fonts/snap-override instead
	install -Dm644 system/fontconfig/05-patrone-fonts.conf \
	    $(pkg)/usr/share/fontconfig/conf.avail/05-patrone-fonts.conf
	install -d $(pkg)/etc/fonts/conf.d
	ln -s ../../../usr/share/fontconfig/conf.avail/05-patrone-fonts.conf \
	    $(pkg)/etc/fonts/conf.d/05-patrone-fonts.conf
	install -Dm644 system/fontconfig/05-patrone-fonts.conf \
	    $(pkg)/etc/fonts/snap-override/05-patrone-fonts.conf
	# And for Flatpak apps: under /usr/share/fonts, the one place every
	# sandbox sees (as /run/host/fonts), with the fonts.conf the session's
	# FONTCONFIG_PATH leads their fontconfig to (copies, not links: a link
	# to /usr/share/fontconfig would lead nowhere in a sandbox)
	install -Dm644 system/fontconfig/05-patrone-fonts.conf \
	    $(pkg)/usr/share/fonts/patrone-fontconfig/05-patrone-fonts.conf
	install -Dm644 system/fontconfig/flatpak-fonts.conf \
	    $(pkg)/usr/share/fonts/patrone-fontconfig/fonts.conf
	install -Dm644 system/environment.d/60-patrone-fontconfig.conf \
	    $(pkg)/etc/environment.d/60-patrone-fontconfig.conf
	# PatroneOS's fonts as LibreOffice's defaults, where it reads its own
	# settings (in place once LibreOffice is installed)
	install -Dm644 system/libreoffice/patroneos-fonts.xcd \
	    $(pkg)/usr/lib/libreoffice/share/registry/patroneos-fonts.xcd
	install -Dm644 -t $(pkg)/usr/share/pixmaps \
	    logos/patrone-logo.png logos/patrone-logo-text.png logos/patrone-logo-text-dark.png \
	    logos/patrone-logo-login.png \
	    logos/patrone-logo-text.svg logos/patrone-logo-text-dark.svg
	# The logo's vector masters (tools/make_logos.py), for anything that
	# wants it at another size
	install -Dm644 -t $(pkg)/usr/share/patrone/logos logos/*.svg
	# The installer's colors, pictures and slides (system/desktop-provision)
	install -d $(pkg)/usr/share/desktop-provision
	cp -r system/desktop-provision/. $(pkg)/usr/share/desktop-provision/
	install -Dm644 logos/patrone-logo-text-dark.png $(pkg)/usr/share/desktop-provision/slides/patrone-logo.png
	# Wallpapers 02 (Neon Horizon) and 03 and their variants
	# (tools/make_wallpapers.py), the generated designs
	# (tools/make_generated_wallpapers.py) and the gallery
	# (tools/make_gallery_wallpapers.py), listed in Settings > Appearance
	install -Dm644 -t $(pkg)/usr/share/backgrounds/patrone \
	    wallpapers/patrone-back-02-*.png wallpapers/patrone-back-03-*.png
	install -Dm644 -t $(pkg)/usr/share/backgrounds/patrone wallpapers/generated/patrone-*.png
	install -Dm644 -t $(pkg)/usr/share/backgrounds/patrone wallpapers/gallery/patrone-*.jpg
	# Wallpaper 01's family is retired. Its names lead to 02's, so a desktop
	# set to one of them still has a wallpaper.
	for name in light plain plain-light clean mark mark-light badge midnight blue graphite watermark; do \
	    ln -s patrone-back-02-$$name.png $(pkg)/usr/share/backgrounds/patrone/patrone-back-01-$$name.png; \
	done
	ln -s patrone-back-02-dark.png $(pkg)/usr/share/backgrounds/patrone/patrone-back-01-8k.png
	install -Dm644 system/backgrounds/patrone-wallpapers.xml \
	    $(pkg)/usr/share/gnome-background-properties/patrone-wallpapers.xml
	install -Dm644 fastfetch/config.jsonc $(pkg)/etc/xdg/fastfetch/config.jsonc
	install -Dm644 fastfetch/logo.txt $(pkg)/usr/share/patrone/fastfetch/logo.txt
	# GNOME's own pages of GNOME Help, which Ubuntu's ubuntu-docs replaces
	# (tools/make_help.sh)
	install -d $(pkg)/usr/share/help
	cp -r help/. $(pkg)/usr/share/help/
	# The P in place of Ubuntu's logo in Yaru's icons: start-here, which
	# Yaru's distributor-logo icons link to, and both symbolic icons
	# (tools/make_logo_icons.sh; preinst moves Yaru's aside)
	install -d $(pkg)/usr/share/icons/Yaru
	cp -r icons/. $(pkg)/usr/share/icons/Yaru/
	# os-release's LOGO, for programs that look in icon themes only
	install -Dm644 icons/48x48/places/start-here.png \
	    $(pkg)/usr/share/icons/hicolor/48x48/apps/patrone-logo.png
	install -Dm644 icons/256x256/places/start-here.png \
	    $(pkg)/usr/share/icons/hicolor/256x256/apps/patrone-logo.png
	install -Dm644 icons/scalable/places/start-here-symbolic.svg \
	    $(pkg)/usr/share/icons/hicolor/symbolic/apps/patrone-logo-symbolic.svg
