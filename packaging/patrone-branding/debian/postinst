#!/bin/sh
set -e

themes=/usr/share/plymouth/themes

if [ "$1" = configure ]; then
    # Above Ubuntu's themes, so they're the defaults unless an admin chose
    # others. The text theme is the one shown when graphics aren't available.
    update-alternatives --install $themes/default.plymouth default.plymouth \
        $themes/patrone/patrone.plymouth 200
    update-alternatives --install $themes/text.plymouth text.plymouth \
        $themes/patrone-text/patrone-text.plymouth 200
    # The login screen's theme, over Yaru's (priority 15). GDM loads it
    # when it next starts.
    update-alternatives --install /usr/share/gnome-shell/gdm-theme.gresource \
        gdm-theme.gresource /usr/share/gnome-shell/theme/Patrone/gnome-shell-theme.gresource 200
    # The system's default cursor theme (/usr/share/icons/default), over
    # Adwaita's (priority 90): for programs that don't follow GNOME's
    # setting, X11 programs and Patrone's compositor among them
    update-alternatives --install /usr/share/icons/default/index.theme \
        x-cursor-theme /usr/share/icons/Patrone/cursor.theme 200
    # Patrone's scripts in place of GRUB's, which preinst moved aside: they
    # run GRUB's without " GNU/Linux" after the system's name. Copies, not
    # links: GRUB's look for their neighbours where they are.
    for file in /etc/grub.d/10_linux /etc/grub.d/10_linux_zfs; do
        install -m755 /usr/lib/patrone-branding/grub-script "$file"
    done
    # The boot splash is in the initramfs, and the boot menu takes its name
    # from os-release.
    if command -v update-initramfs > /dev/null; then
        update-initramfs -u
    fi
    if command -v update-grub > /dev/null; then
        update-grub
    fi
fi

#DEBHELPER#
