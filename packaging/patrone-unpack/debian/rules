#!/usr/bin/make -f
# The source tree arrives with its crates vendored (packaging/build.sh), so
# cargo never touches the network.

export CARGO_HOME = $(CURDIR)/debian/cargo-home
pkg = debian/patrone-unpack

%:
	dh $@

override_dh_auto_build:
	cargo build --release --frozen

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --frozen
endif

override_dh_auto_install:
	install -Dm755 target/release/patrone-unpack $(pkg)/usr/bin/patrone-unpack
	install -Dm644 data/org.patrone.Unpack.desktop $(pkg)/usr/share/applications/org.patrone.Unpack.desktop
	install -Dm644 data/org.patrone.Unpack.svg $(pkg)/usr/share/icons/hicolor/scalable/apps/org.patrone.Unpack.svg
	# Installs a .deb with apt, as root through pkexec, under its own polkit
	# action (an administrator's password every time)
	install -Dm755 data/install-deb $(pkg)/usr/libexec/patrone-unpack/install-deb
	install -Dm644 data/org.patrone.unpack.policy $(pkg)/usr/share/polkit-1/actions/org.patrone.unpack.policy
	# Flathub's own repository file, added to an account when a Flatpak
	# app's runtime has to come from Flathub
	install -Dm644 data/flathub.flatpakrepo $(pkg)/usr/share/patrone-unpack/flathub.flatpakrepo

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean deletes *.orig files, but every vendored crate has a
# Cargo.toml.orig that cargo checksums.
override_dh_clean:
	dh_clean -XCargo.toml.orig
