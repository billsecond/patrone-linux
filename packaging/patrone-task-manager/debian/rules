#!/usr/bin/make -f
# The source tree arrives with its crates vendored (packaging/build.sh), so
# cargo never touches the network.

export CARGO_HOME = $(CURDIR)/debian/cargo-home
pkg = debian/patrone-task-manager

%:
	dh $@

override_dh_auto_build:
	cargo build --release --frozen

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --frozen
endif

override_dh_auto_install:
	install -Dm755 target/release/patrone-task-manager $(pkg)/usr/bin/patrone-task-manager
	install -Dm644 data/org.patrone.TaskManager.desktop \
	    $(pkg)/usr/share/applications/org.patrone.TaskManager.desktop
	install -Dm644 data/org.patrone.TaskManager.svg \
	    $(pkg)/usr/share/icons/hicolor/scalable/apps/org.patrone.TaskManager.svg
	# Ctrl+Shift+Esc: a custom shortcut in Patrone's dconf database, which
	# postinst compiles, and the vendor profile that reads it (an
	# administrator's /etc/dconf/profile/user takes its place)
	install -Dm644 data/dconf/50-patrone-task-manager \
	    $(pkg)/etc/dconf/db/patrone.d/50-patrone-task-manager
	install -Dm644 data/dconf/profile-user $(pkg)/usr/share/dconf/profile/user

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean deletes *.orig files, but every vendored crate has a
# Cargo.toml.orig that cargo checksums.
override_dh_clean:
	dh_clean -XCargo.toml.orig
