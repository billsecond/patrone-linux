#!/bin/sh
set -e

if [ "$1" = remove ] || [ "$1" = purge ]; then
    # The compiled database belongs to no package: remove it, and compile
    # it again if other Patrone packages still put settings in patrone.d
    rm -f /etc/dconf/db/patrone
    if [ -d /etc/dconf/db/patrone.d ] && command -v dconf > /dev/null; then
        dconf update || true
    fi
fi

#DEBHELPER#
