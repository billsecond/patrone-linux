#!/usr/bin/make -f
# The source tree arrives with its crates vendored (packaging/build.sh), so
# cargo never touches the network.

export CARGO_HOME = $(CURDIR)/debian/cargo-home
pkg = debian/patrone-file-manager

%:
	dh $@

override_dh_auto_build:
	cargo build --release --frozen

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --release --frozen
endif

override_dh_auto_install:
	install -Dm755 target/release/patrone-file-manager $(pkg)/usr/bin/patrone-file-manager
	install -Dm644 data/org.patrone.FileManager.desktop $(pkg)/usr/share/applications/org.patrone.FileManager.desktop
	install -Dm644 data/org.patrone.FileManager.svg $(pkg)/usr/share/icons/hicolor/scalable/apps/org.patrone.FileManager.svg
	# Folder Options' settings; dpkg's trigger compiles the schemas
	install -Dm644 data/org.patrone.FileManager.gschema.xml $(pkg)/usr/share/glib-2.0/schemas/org.patrone.FileManager.gschema.xml
	# Reopens folders at sign-in, only when Folder Options says to
	install -Dm644 data/autostart/org.patrone.FileManager-restore.desktop $(pkg)/etc/xdg/autostart/org.patrone.FileManager-restore.desktop
	# In place of Nautilus's, which preinst moves aside: "show in folder"
	# starts File Manager, and GNOME's Files is hidden (see preinst)
	install -Dm644 data/retire-nautilus/org.freedesktop.FileManager1.service $(pkg)/usr/share/dbus-1/services/org.freedesktop.FileManager1.service
	install -Dm644 data/retire-nautilus/org.gnome.Nautilus.desktop $(pkg)/usr/share/applications/org.gnome.Nautilus.desktop

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean deletes *.orig files, but every vendored crate has a
# Cargo.toml.orig that cargo checksums.
override_dh_clean:
	dh_clean -XCargo.toml.orig
