#!/bin/sh
# Patrone File Manager replaces GNOME's Files (Nautilus) without removing it:
# Ubuntu's session and GNOME's file dialogs for Snap and Flatpak apps need
# Nautilus. Its menu entry is replaced by a hidden one, and the D-Bus
# service that apps ask to "show a file in its folder" starts Patrone File
# Manager. Nautilus's own files are kept as *.nautilus and come back when
# this package is removed (postrm).
set -e

diverted="
/usr/share/applications/org.gnome.Nautilus.desktop
/usr/share/dbus-1/services/org.freedesktop.FileManager1.service
"

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    for file in $diverted; do
        dpkg-divert --package patrone-file-manager --add --rename --divert "$file.nautilus" "$file"
    done
fi

#DEBHELPER#
