+/* The desktop-files setting's values, in the row's order */
+static const char * const patrone_files[] = { "desktop", "panel", "hidden" };
+
+static const struct
+{
+  const char *value;
+  const char *title;
+} patrone_corners[] = {
+  { "none", N_("No Corner") },
+  { "top-left", N_("Top Left") },
+  { "top-right", N_("Top Right") },
+  { "bottom-left", N_("Bottom Left") },
+  { "bottom-right", N_("Bottom Right") },
+};
+
+static gboolean
+patrone_files_get_mapping (GValue   *value,
+                           GVariant *variant,
+                           gpointer  user_data)
+{
+  const char *mode = g_variant_get_string (variant, NULL);
+
+  for (guint i = 0; i < G_N_ELEMENTS (patrone_files); i++)
+    {
+      if (g_str_equal (mode, patrone_files[i]))
+        {
+          g_value_set_uint (value, i);
+          return TRUE;
+        }
+    }
+  return FALSE;
+}
+
+static GVariant *
+patrone_files_set_mapping (const GValue       *value,
+                           const GVariantType *type,
+                           gpointer            user_data)
+{
+  guint selected = g_value_get_uint (value);
+
+  return g_variant_new_string (patrone_files[MIN (selected, G_N_ELEMENTS (patrone_files) - 1)]);
+}
+
+/* Whether something else uses a corner, from the taskbar's list of
+ * "corner:user" */
+static gboolean
+patrone_corner_in_use (GStrv in_use, const char *corner)
+{
+  g_autofree char *prefix = g_strconcat (corner, ":", NULL);
+
+  for (guint i = 0; in_use[i] != NULL; i++)
+    {
+      if (g_str_has_prefix (in_use[i], prefix))
+        return TRUE;
+    }
+  return FALSE;
+}
+
+/* The corner row, on a clean desktop: the corners nothing else uses, and the
+ * one chosen whatever it is, saying so if something has taken it. The Recycle
+ * Bin's switch means nothing there: it's off the desktop whatever it says. */
+static void
+patrone_desktop_sync (CcUbuntuPanel *self)
+{
+  g_autofree char *mode = g_settings_get_string (self->patrone_taskbar_settings, "desktop-files");
+  g_autofree char *corner = g_settings_get_string (self->patrone_taskbar_settings,
+                                                   "desktop-files-corner");
+  g_auto(GStrv) in_use = g_settings_get_strv (self->patrone_taskbar_settings,
+                                              "desktop-corners-in-use");
+  g_autoptr(GtkStringList) list = gtk_string_list_new (NULL);
+  gboolean clean = g_str_equal (mode, "hidden");
+  guint selected = 0;
+
+  gtk_widget_set_visible (GTK_WIDGET (self->patrone_corner_row), clean);
+  gtk_widget_set_visible (GTK_WIDGET (self->patrone_bin_switch), !clean);
+
+  g_clear_pointer (&self->patrone_corners, g_ptr_array_unref);
+  self->patrone_corners = g_ptr_array_new ();
+  for (guint i = 0; i < G_N_ELEMENTS (patrone_corners); i++)
+    {
+      const char *value = patrone_corners[i].value;
+      gboolean in_use_now = patrone_corner_in_use (in_use, value);
+      gboolean chosen = g_str_equal (value, corner);
+      g_autofree char *title = NULL;
+
+      if (in_use_now && !chosen)
+        continue;
+      if (chosen)
+        selected = self->patrone_corners->len;
+      title = in_use_now
+        ? g_strdup_printf (_("%s (in use)"), _(patrone_corners[i].title))
+        : g_strdup (_(patrone_corners[i].title));
+      gtk_string_list_append (list, title);
+      g_ptr_array_add (self->patrone_corners, (gpointer) value);
+    }
+
+  self->patrone_updating = TRUE;
+  adw_combo_row_set_model (self->patrone_corner_row, G_LIST_MODEL (list));
+  adw_combo_row_set_selected (self->patrone_corner_row, selected);
+  self->patrone_updating = FALSE;
+}
+
+static void
+on_patrone_corner_changed (CcUbuntuPanel *self)
+{
+  guint selected = adw_combo_row_get_selected (self->patrone_corner_row);
+
+  if (self->patrone_updating || self->patrone_corners == NULL ||
+      selected >= self->patrone_corners->len)
+    return;
+  g_settings_set_string (self->patrone_taskbar_settings, "desktop-files-corner",
+                         g_ptr_array_index (self->patrone_corners, selected));
+}
