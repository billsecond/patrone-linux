+
+/* Patrone: with Patrone Remote Desktop installed, its page (in Remote
+ * Login's place, see cc-remote-login-page.c) is the first tab, named
+ * Remote Desktop, with Desktop Sharing after it */
+static void
+put_remote_desktop_first (CcRemoteDesktopPage *self)
+{
+  GtkWidget *sharing = GTK_WIDGET (self->desktop_sharing_page);
+  AdwViewStackPage *page = adw_view_stack_get_page (self->stack, sharing);
+  g_autofree char *title = g_strdup (adw_view_stack_page_get_title (page));
+  g_autofree char *icon = g_strdup (adw_view_stack_page_get_icon_name (page));
+
+  page = adw_view_stack_get_page (self->stack, GTK_WIDGET (self->remote_login_page));
+  adw_view_stack_page_set_title (page, _("_Remote Desktop"));
+
+  g_object_ref (sharing);
+  adw_view_stack_remove (self->stack, sharing);
+  page = adw_view_stack_add_titled_with_icon (self->stack, sharing, CC_PATRONE_DESKTOP_SHARING_TAB,
+                                              title, icon);
+  adw_view_stack_page_set_use_underline (page, TRUE);
+  g_object_bind_property (sharing, "visible", page, "visible", G_BINDING_SYNC_CREATE);
+  g_object_unref (sharing);
+
+  adw_view_stack_set_visible_child (self->stack, GTK_WIDGET (self->remote_login_page));
 }
 
 static void
@@ -73,4 +105,12 @@
   gtk_widget_init_template (GTK_WIDGET (self));
 
   self->cancellable = g_cancellable_new ();
+
+  /* Patrone: GNOME's page shows only where Desktop Sharing can; with
+   * Patrone Remote Desktop it always shows */
+  if (cc_patrone_remote_login_available ())
+    put_remote_desktop_first (self);
+  else
+    g_object_bind_property (self->desktop_sharing_page, "visible", self, "visible",
+                            G_BINDING_SYNC_CREATE);
 }
